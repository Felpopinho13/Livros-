@model AdminTrocasViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Trocas";

    List<int> MontarPaginas(int paginaAtual, int totalPaginas) {
        var paginas = new List<int>();
        if (totalPaginas <= 5) {
            paginas.AddRange(Enumerable.Range(1, totalPaginas));
            return paginas;
        }

        paginas.Add(1);
        var inicio = Math.Max(2, paginaAtual - 1);
        var fim = Math.Min(totalPaginas - 1, paginaAtual + 1);

        if (paginaAtual <= 3) {
            inicio = 2;
            fim = 4;
        }
        else if (paginaAtual >= totalPaginas - 2) {
            inicio = totalPaginas - 3;
            fim = totalPaginas - 1;
        }

        for (var i = inicio; i <= fim; i++) {
            paginas.Add(i);
        }

        paginas.Add(totalPaginas);
        return paginas;
    }

    var paginasTrocas = MontarPaginas(Model.PaginaTrocasAtual, Model.TotalPaginasTrocas);
    var paginasCupons = MontarPaginas(Model.PaginaCuponsAtual, Model.TotalPaginasCupons);
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/admin/admin-trocas.css" />
}

<div class="admin-page-header exchange-page-header">
    <h2>Trocas e Devolucoes</h2>
</div>

@if (Model.TotalPaginasTrocas > 1) {
    <div class="admin-pagination exchange-pagination">
        @if (Model.PaginaTrocasAtual > 1) {
            <a asp-controller="Admin" asp-action="Trocas" asp-route-busca="@Model.Busca" asp-route-status="@Model.StatusFiltro" asp-route-paginaTrocas="@(Model.PaginaTrocasAtual - 1)" asp-route-paginaCupons="@Model.PaginaCuponsAtual" class="page-btn">Anterior</a>
        }

        @for (var indice = 0; indice < paginasTrocas.Count; indice++) {
            var pagina = paginasTrocas[indice];
            if (indice > 0 && pagina - paginasTrocas[indice - 1] > 1) {
                <span class="page-ellipsis">...</span>
            }

            <a asp-controller="Admin" asp-action="Trocas" asp-route-busca="@Model.Busca" asp-route-status="@Model.StatusFiltro" asp-route-paginaTrocas="@pagina" asp-route-paginaCupons="@Model.PaginaCuponsAtual" class="page-number @(pagina == Model.PaginaTrocasAtual ? "active" : string.Empty)">@pagina</a>
        }

        @if (Model.PaginaTrocasAtual < Model.TotalPaginasTrocas) {
            <a asp-controller="Admin" asp-action="Trocas" asp-route-busca="@Model.Busca" asp-route-status="@Model.StatusFiltro" asp-route-paginaTrocas="@(Model.PaginaTrocasAtual + 1)" asp-route-paginaCupons="@Model.PaginaCuponsAtual" class="page-btn">PrÃ³xima</a>
        }
    </div>
}

@if (TempData["Sucesso"] != null) {
    <div class="checkout-alert checkout-alert-success">@TempData["Sucesso"]</div>
}

@if (TempData["Erro"] != null) {
    <div class="checkout-alert checkout-alert-error">@TempData["Erro"]</div>
}

<div class="exchange-toolbar">
    <form asp-controller="Admin" asp-action="Trocas" method="get" class="exchange-filters">
        <input type="text" name="busca" value="@Model.Busca" class="admin-input exchange-search" placeholder="Buscar por cliente, pedido ou troca..." />

        <select name="status" class="admin-select exchange-select">
            <option value="">Todos Status</option>
                        <option value="EM TROCA" selected="@(Model.StatusFiltro == "EM TROCA")">EM TROCA</option>
                        <option value="TROCA AUTORIZADA" selected="@(Model.StatusFiltro == "TROCA AUTORIZADA")">TROCA AUTORIZADA</option>
                        <option value="TROCADO" selected="@(Model.StatusFiltro == "TROCADO")">TROCADO</option>
                        <option value="TROCA RECUSADA" selected="@(Model.StatusFiltro == "TROCA RECUSADA")">TROCA RECUSADA</option>
        </select>

        <button type="submit" class="btn-secondary exchange-filter-btn">Filtrar</button>
    </form>

    <button type="button" class="btn-primary exchange-create-btn" onclick="abrirModalCupom()">
        Gerar cupom promocional
    </button>
</div>

<div class="admin-table-wrapper exchange-table-wrapper">
    <table class="admin-table exchange-table">
        <thead>
            <tr>
                <th>#Troca</th>
                <th>#Pedido</th>
                <th>Cliente</th>
                <th>Livro</th>
                <th>Motivo</th>
                <th>Status</th>
                <th>Data</th>
                <th>Acoes</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Trocas.Any()) {
                <tr>
                    <td colspan="8" class="exchange-empty-state">Nenhuma solicitacao de troca encontrada.</td>
                </tr>
            }
            else {
                @foreach (var troca in Model.Trocas) {
                    var clienteEscapado = troca.ClienteNome.Replace("\\", "\\\\").Replace("'", "\\'");
                    var motivoEscapado = troca.Motivo.Replace("\\", "\\\\").Replace("'", "\\'");
                    var observacaoClienteEscapada = (troca.ObservacaoCliente ?? string.Empty).Replace("\\", "\\\\").Replace("'", "\\'");
                    var observacaoAdminEscapada = (troca.ObservacaoAdmin ?? string.Empty).Replace("\\", "\\\\").Replace("'", "\\'");
                    var codigoCupomEscapado = (troca.CodigoCupom ?? string.Empty).Replace("\\", "\\\\").Replace("'", "\\'");
                    var dataRecebimentoTexto = troca.DataRecebimento?.ToString("dd/MM/yyyy HH:mm") ?? string.Empty;
                    var dataRecebimentoEscapada = dataRecebimentoTexto.Replace("\\", "\\\\").Replace("'", "\\'");
                    var statusClass = troca.Status.ToLowerInvariant().Replace(" ", "-");
                    var textoAcao = troca.PodeAnalisar
                        ? "Analisar"
                        : troca.PodeConfirmarRecebimento
                            ? "Receber item"
                            : "Ver";
                    var classeAcao = troca.PodeAnalisar || troca.PodeConfirmarRecebimento
                        ? "btn-primary"
                        : "btn-secondary";
                    var retornoAoEstoqueTexto = troca.RetornarAoEstoque.HasValue
                        ? (troca.RetornarAoEstoque.Value ? "sim" : "nao")
                        : string.Empty;

                    <tr>
                        <td>@troca.Codigo</td>
                        <td>#@troca.PedidoId</td>
                        <td>@troca.ClienteNome</td>
                        <td>@troca.LivroTitulo</td>
                        <td>@troca.Motivo</td>
                        <td>
                            <span class="exchange-status @statusClass">@troca.Status</span>
                        </td>
                        <td>@troca.DataSolicitacao.ToString("dd/MM/yyyy")</td>
                        <td class="admin-actions exchange-actions">
                            <button type="button"
                                    class="@classeAcao exchange-action-btn"
                                    onclick="abrirModalTroca(@troca.Id, '@troca.Codigo', '#@troca.PedidoId', '@clienteEscapado', '@motivoEscapado', '@observacaoClienteEscapada', '@observacaoAdminEscapada', @troca.ValorSugeridoCupom.ToString(System.Globalization.CultureInfo.InvariantCulture), '@codigoCupomEscapado', '@troca.Status', '@dataRecebimentoEscapada', '@retornoAoEstoqueTexto', @((troca.ValorCupomGerado ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)))">
                                @textoAcao
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.CuponsRecentes.Any()) {
    <div class="exchange-coupons-panel">
        <div class="exchange-coupons-header">
            <h3>Cupons recentes</h3>
            <p>Ultimos cupons gerados no painel para promocao ou troca.</p>
        </div>

        <div class="exchange-coupon-grid">
            @foreach (var cupom in Model.CuponsRecentes) {
                var tipoClass = cupom.Tipo.ToLowerInvariant();
                var statusTexto = !cupom.IsAtivo ? "Inativo" : cupom.DataUtilizacao.HasValue ? "Utilizado" : "Ativo";
                <div class="exchange-coupon-card">
                    <span class="exchange-coupon-type @tipoClass">@cupom.Tipo</span>
                    <strong>@cupom.Codigo</strong>
                    <span>R$ @cupom.Valor.ToString("N2")</span>
                    <small>@statusTexto</small>
                </div>
            }
        </div>
    </div>
}

<div class="exchange-coupons-panel exchange-coupon-list-panel">
    <div class="exchange-coupons-header">
        <h3>Gerenciamento de cupons</h3>
        <p>Acompanhe status, uso e desative cupons promocionais ativos quando necessario.</p>
    </div>

    <div class="admin-table-wrapper exchange-table-wrapper">
        <table class="admin-table exchange-table exchange-coupon-table">
            <thead>
                <tr>
                    <th>Codigo</th>
                    <th>Tipo</th>
                    <th>Publico</th>
                    <th>Valor</th>
                    <th>Status</th>
                    <th>Cliente</th>
                    <th>Pedido</th>
                    <th>Criacao</th>
                    <th>Uso</th>
                    <th>Acoes</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Cupons.Any()) {
                    <tr>
                        <td colspan="10" class="exchange-empty-state">Nenhum cupom encontrado.</td>
                    </tr>
                }
                else {
                    @foreach (var cupom in Model.Cupons) {
                        var tipoClass = cupom.Tipo.ToLowerInvariant();
                        var statusClass = cupom.Status.ToLowerInvariant().Replace(" ", "-");
                        <tr>
                            <td><strong>@cupom.Codigo</strong></td>
                            <td><span class="exchange-coupon-type @tipoClass">@cupom.Tipo</span></td>
                            <td>@cupom.Publico</td>
                            <td>R$ @cupom.Valor.ToString("N2")</td>
                            <td><span class="exchange-status @statusClass">@cupom.Status</span></td>
                            <td>@(string.IsNullOrWhiteSpace(cupom.ClienteNome) ? "-" : cupom.ClienteNome)</td>
                            <td>@(cupom.PedidoId.HasValue ? $"#{cupom.PedidoId}" : "-")</td>
                            <td>@cupom.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(cupom.DataUtilizacao.HasValue ? cupom.DataUtilizacao.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                            <td class="admin-actions exchange-actions">
                                @if (cupom.PodeDesativar) {
                                    <form asp-controller="Admin" asp-action="DesativarCupomDesconto" method="post" class="exchange-inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cupom.Id" />
                                        <button type="submit" class="btn-secondary exchange-action-btn exchange-danger-btn">Desativar</button>
                                    </form>
                                }
                                else {
                                    <span class="exchange-muted-action">Sem acao</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPaginasCupons > 1) {
    <div class="admin-pagination exchange-pagination">
        @if (Model.PaginaCuponsAtual > 1) {
            <a asp-controller="Admin" asp-action="Trocas" asp-route-busca="@Model.Busca" asp-route-status="@Model.StatusFiltro" asp-route-paginaTrocas="@Model.PaginaTrocasAtual" asp-route-paginaCupons="@(Model.PaginaCuponsAtual - 1)" class="page-btn">Anterior</a>
        }

        @for (var indice = 0; indice < paginasCupons.Count; indice++) {
            var pagina = paginasCupons[indice];
            if (indice > 0 && pagina - paginasCupons[indice - 1] > 1) {
                <span class="page-ellipsis">...</span>
            }

            <a asp-controller="Admin" asp-action="Trocas" asp-route-busca="@Model.Busca" asp-route-status="@Model.StatusFiltro" asp-route-paginaTrocas="@Model.PaginaTrocasAtual" asp-route-paginaCupons="@pagina" class="page-number @(pagina == Model.PaginaCuponsAtual ? "active" : string.Empty)">@pagina</a>
        }

        @if (Model.PaginaCuponsAtual < Model.TotalPaginasCupons) {
            <a asp-controller="Admin" asp-action="Trocas" asp-route-busca="@Model.Busca" asp-route-status="@Model.StatusFiltro" asp-route-paginaTrocas="@Model.PaginaTrocasAtual" asp-route-paginaCupons="@(Model.PaginaCuponsAtual + 1)" class="page-btn">PrÃ³xima</a>
        }
    </div>
}

<div class="admin-modal-overlay" id="trocaModal" style="display:none;">
    <div class="admin-modal exchange-modal">
        <div class="admin-modal-header">
            <h3 id="trocaModalTitulo">Analisar troca</h3>
            <button type="button" class="modal-close" onclick="fecharModal('trocaModal')">&times;</button>
        </div>

        <form asp-controller="Admin" asp-action="AnalisarTroca" method="post" id="trocaForm">
            @Html.AntiForgeryToken()
            <div class="admin-modal-body">
                <input type="hidden" id="trocaId" name="trocaId" />

                <div class="exchange-modal-grid">
                    <div>
                        <label>NÂº Troca</label>
                        <div class="exchange-modal-value" id="trocaCodigo"></div>
                    </div>
                    <div>
                        <label>Pedido</label>
                        <div class="exchange-modal-value" id="trocaPedido"></div>
                    </div>
                    <div>
                        <label>Cliente</label>
                        <div class="exchange-modal-value" id="trocaCliente"></div>
                    </div>
                    <div>
                        <label>Status</label>
                        <div class="exchange-modal-value" id="trocaStatusAtual"></div>
                    </div>
                </div>

                <div class="admin-form-group">
                    <label>Motivo</label>
                    <div class="exchange-modal-box" id="trocaMotivo"></div>
                </div>

                <div class="admin-form-group">
                    <label>Observacao do cliente</label>
                    <div class="exchange-modal-box" id="trocaObservacaoCliente"></div>
                </div>

                <div class="admin-form-group exchange-analysis-fields">
                    <label for="decisaoTroca">Decisao</label>
                    <select id="decisaoTroca" name="decisao" class="admin-select">
                        <option value="aprovar">Aprovar</option>
                        <option value="recusar">Recusar</option>
                    </select>
                    <small class="exchange-help">Ao autorizar a troca, o sistema libera a próxima etapa de recebimento. O cupom ainda não é gerado aqui.</small>
                </div>

                <div class="admin-form-group exchange-receipt-fields" style="display:none;">
                    <label for="retornarAoEstoqueTroca">Item retorna ao estoque?</label>
                    <select id="retornarAoEstoqueTroca" name="retornarAoEstoque" class="admin-select">
                        <option value="true">Sim, reintegrar ao estoque</option>
                        <option value="false">Nao, descartar o item devolvido</option>
                    </select>
                </div>

                <div class="admin-form-group exchange-receipt-fields" style="display:none;">
                    <label for="valorCupomTroca">Valor do cupom gerado</label>
                    <input type="text" id="valorCupomTroca" name="valorCupom" class="admin-input" inputmode="decimal" placeholder="0,00" />
                    <small class="exchange-help">No recebimento, este valor sera salvo como cupom de troca para o cliente.</small>
                </div>

                <div class="exchange-modal-grid exchange-receipt-meta" id="trocaRecebimentoMeta" style="display:none;">
                    <div>
                        <label>Recebido em</label>
                        <div class="exchange-modal-value" id="trocaDataRecebimento"></div>
                    </div>
                    <div>
                        <label>Retorno ao estoque</label>
                        <div class="exchange-modal-value" id="trocaRetornoAoEstoque"></div>
                    </div>
                </div>

                <div class="admin-form-group">
                    <label for="observacaoAdminTroca">Observacao do admin</label>
                    <textarea id="observacaoAdminTroca" name="observacaoAdmin" class="admin-input" rows="4" placeholder="Descreva a analise da solicitacao."></textarea>
                </div>

                <div class="exchange-coupon-box" id="cupomGeradoBox" style="display:none;">
                    <span>Cupom gerado</span>
                    <strong id="cupomGeradoCodigo"></strong>
                </div>
            </div>

            <div class="admin-modal-footer">
                <button type="button" class="btn-secondary" onclick="fecharModal('trocaModal')">Fechar</button>
                <button type="submit" class="btn-primary exchange-analysis-submit">Confirmar analise</button>
                <button type="submit" class="btn-primary exchange-receipt-submit" style="display:none;">Confirmar recebimento</button>
            </div>
        </form>
    </div>
</div>

<div class="admin-modal-overlay" id="cupomModal" style="display:none;">
    <div class="admin-modal exchange-modal exchange-coupon-modal">
        <div class="admin-modal-header">
            <h3>Gerar cupom promocional</h3>
            <button type="button" class="modal-close" onclick="fecharModal('cupomModal')">&times;</button>
        </div>

        <form asp-controller="Admin" asp-action="GerarCupomDesconto" method="post">
            @Html.AntiForgeryToken()
            <div class="admin-modal-body">
                <div class="admin-form-group">
                    <label for="valorCupomPromocional">Valor do desconto</label>
                    <input type="text" id="valorCupomPromocional" name="valor" class="admin-input" inputmode="decimal" placeholder="0,00" required />
                </div>

                <div class="admin-form-group">
                    <label for="destinatarioCupomPromocional">Disponibilizar para</label>
                    <select id="destinatarioCupomPromocional" name="destinatario" class="admin-select">
                        <option value="manual">Somente por codigo</option>
                        <option value="cliente">Cliente especifico</option>
                        <option value="todos">Todos os clientes</option>
                    </select>
                    <small class="exchange-help">Cupom promocional vale uma vez e abate somente o valor do produto. Ao escolher todos, o sistema cria uma copia do cupom para cada cliente ativo.</small>
                </div>

                <div class="admin-form-group exchange-coupon-client-group" id="cupomClienteGroup" style="display:none;">
                    <label for="clienteCupomPromocionalBusca">Cliente especÃ­fico</label>
                    <input type="text"
                           id="clienteCupomPromocionalBusca"
                           class="admin-input"
                           list="clientesCupomPromocional"
                           placeholder="Pesquise pelo nome do cliente" />
                    <input type="hidden" id="clienteCupomPromocionalId" name="clienteId" />
                    <datalist id="clientesCupomPromocional">
                        @foreach (var cliente in Model.ClientesAtivos) {
                            <option value="@($"{cliente.Nome} - {cliente.Email}")" data-id="@cliente.Id"></option>
                        }
                    </datalist>
                    <small class="exchange-help">Selecione um cliente pelo nome para que o cupom apareÃ§a em Meus cupons dessa conta.</small>
                </div>
            </div>

            <div class="admin-modal-footer">
                <button type="button" class="btn-secondary" onclick="fecharModal('cupomModal')">Cancelar</button>
                <button type="submit" class="btn-primary">Gerar cupom</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function abrirModalTroca(id, codigo, pedido, cliente, motivo, observacaoCliente, observacaoAdmin, valorCupom, codigoCupom, status, dataRecebimento, retornoAoEstoque, valorCupomGerado) {
        document.getElementById('trocaId').value = id;
        document.getElementById('trocaCodigo').textContent = codigo;
        document.getElementById('trocaPedido').textContent = pedido;
        document.getElementById('trocaCliente').textContent = cliente;
        document.getElementById('trocaStatusAtual').textContent = status;
        document.getElementById('trocaMotivo').textContent = motivo || '-';
        document.getElementById('trocaObservacaoCliente').textContent = observacaoCliente || 'Sem observacao informada.';
        document.getElementById('observacaoAdminTroca').value = observacaoAdmin || '';
        document.getElementById('valorCupomTroca').value = (valorCupomGerado > 0 ? valorCupomGerado : valorCupom) > 0
            ? (valorCupomGerado > 0 ? valorCupomGerado : valorCupom).toFixed(2).replace('.', ',')
            : '';
        document.getElementById('cupomGeradoCodigo').textContent = codigoCupom || '';
        document.getElementById('trocaDataRecebimento').textContent = dataRecebimento || 'Ainda não confirmado';
        document.getElementById('trocaRetornoAoEstoque').textContent = retornoAoEstoque === 'sim'
            ? 'Sim'
            : retornoAoEstoque === 'nao'
                ? 'Nao'
                : 'Pendente de definição';
        document.getElementById('retornarAoEstoqueTroca').value = retornoAoEstoque === 'nao' ? 'false' : 'true';

        const camposAnalise = document.querySelectorAll('.exchange-analysis-fields');
        const camposRecebimento = document.querySelectorAll('.exchange-receipt-fields');
        const submitAnalise = document.querySelector('.exchange-analysis-submit');
        const submitRecebimento = document.querySelector('.exchange-receipt-submit');
        const cupomGeradoBox = document.getElementById('cupomGeradoBox');
        const blocoRecebimento = document.getElementById('trocaRecebimentoMeta');
        const form = document.getElementById('trocaForm');
        const modoAnalise = status === 'EM TROCA';
        const modoRecebimento = status === 'TROCA AUTORIZADA';
        const somenteLeitura = !modoAnalise && !modoRecebimento;

        camposAnalise.forEach((campo) => {
            campo.style.display = modoAnalise ? '' : 'none';
        });

        camposRecebimento.forEach((campo) => {
            campo.style.display = modoRecebimento ? '' : 'none';
        });

        submitAnalise.style.display = modoAnalise ? '' : 'none';
        submitRecebimento.style.display = modoRecebimento ? '' : 'none';
        document.getElementById('decisaoTroca').disabled = !modoAnalise;
        document.getElementById('valorCupomTroca').disabled = !modoRecebimento;
        document.getElementById('retornarAoEstoqueTroca').disabled = !modoRecebimento;
        document.getElementById('observacaoAdminTroca').readOnly = somenteLeitura;
        cupomGeradoBox.style.display = codigoCupom ? 'flex' : 'none';
        blocoRecebimento.style.display = (dataRecebimento || somenteLeitura) ? 'grid' : 'none';
        form.action = modoRecebimento ? '@Url.Action("ConfirmarRecebimentoTroca", "Admin")' : '@Url.Action("AnalisarTroca", "Admin")';
        document.getElementById('trocaModalTitulo').textContent = modoAnalise
            ? 'Analisar troca'
            : modoRecebimento
                ? 'Confirmar recebimento'
                : 'Detalhes da troca';
        document.getElementById('trocaModal').style.display = 'flex';
    }

    function abrirModalCupom() {
        document.getElementById('valorCupomPromocional').value = '';
        document.getElementById('destinatarioCupomPromocional').value = 'manual';
        document.getElementById('clienteCupomPromocionalBusca').value = '';
        document.getElementById('clienteCupomPromocionalId').value = '';
        atualizarDestinoCupom();
        document.getElementById('cupomModal').style.display = 'flex';
    }

    function atualizarDestinoCupom() {
        const destino = document.getElementById('destinatarioCupomPromocional')?.value;
        const grupoCliente = document.getElementById('cupomClienteGroup');
        const clienteInput = document.getElementById('clienteCupomPromocionalBusca');
        const clienteIdInput = document.getElementById('clienteCupomPromocionalId');

        if (!grupoCliente || !clienteInput || !clienteIdInput) {
            return;
        }

        const mostrarCliente = destino === 'cliente';
        grupoCliente.style.display = mostrarCliente ? 'block' : 'none';

        if (!mostrarCliente) {
            clienteInput.value = '';
            clienteIdInput.value = '';
        }
    }

    function sincronizarClienteCupom() {
        const clienteInput = document.getElementById('clienteCupomPromocionalBusca');
        const clienteIdInput = document.getElementById('clienteCupomPromocionalId');
        const lista = document.getElementById('clientesCupomPromocional');

        if (!clienteInput || !clienteIdInput || !lista) {
            return;
        }

        const valor = clienteInput.value;
        const opcao = Array.from(lista.options).find(option => option.value === valor);
        clienteIdInput.value = opcao ? opcao.dataset.id : '';
    }

    function fecharModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }

    document.querySelectorAll('.admin-modal-overlay').forEach((overlay) => {
        overlay.addEventListener('click', function (event) {
            if (event.target === overlay) {
                overlay.style.display = 'none';
            }
        });
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            fecharModal('trocaModal');
            fecharModal('cupomModal');
        }
    });

    document.getElementById('destinatarioCupomPromocional')?.addEventListener('change', atualizarDestinoCupom);
    document.getElementById('clienteCupomPromocionalBusca')?.addEventListener('input', sincronizarClienteCupom);
</script>
}

