@model List<Livros.Domain.Livro>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Livros";
    var categoriasDisponiveis = ViewBag.CategoriasDisponiveis as List<Livros.Domain.Categoria> ?? new List<Livros.Domain.Categoria>();
}
@if (TempData["Erro"] != null) {
    <div class="alert-error">
        @TempData["Erro"]
    </div>
}

<div class="admin-page-header">
    <h2>Livros</h2>

    <button class="btn-primary" onclick="abrirModalNovoLivro()">
        + Novo Livro
    </button>
</div>

<div class="admin-table-wrapper">

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Categorias</th>
                <th>ISBN</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Any()) {
                <tr>
                    <td colspan="6" style="text-align:center;">
                        Nenhum livro cadastrado
                    </td>
                </tr>
            }
            else {
                @foreach (var livro in Model) {
                    <tr>
                        <td>@livro.Id</td>
                        <td>@livro.Titulo</td>
                        <td>@livro.Autor</td>
                        <td>
                            @if (livro.Categorias != null && livro.Categorias.Any()) {
                                <div class="admin-tag-list">
                                    @foreach (var categoria in livro.Categorias.OrderBy(c => c.Nome)) {
                                        <span class="admin-tag">@categoria.Nome</span>
                                    }
                                </div>
                            }
                            else {
                                <span class="admin-muted">Sem categoria</span>
                            }
                        </td>
                        <td>@livro.ISBN</td>

                        <td>
                            @if (livro.IsAtivo) {
                                <span class="status success">Ativo</span>
                            }
                            else {
                                <span class="status danger">Inativo</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div>

<!-- MODAL NOVO LIVRO -->
<div class="admin-modal-overlay" id="novoLivroModal" style="display:none;">
    <div class="admin-modal large admin-book-modal">

        <div class="admin-modal-header admin-book-modal-header">
            <div>
                <span class="admin-modal-kicker">Catálogo</span>
                <h3>Novo Livro</h3>
            </div>
            <button class="modal-close" type="button" aria-label="Fechar modal" onclick="fecharModalNovoLivro()">×</button>
        </div>

        <form asp-action="CriarLivro" method="post" enctype="multipart/form-data">
            <div class="admin-modal-body admin-book-modal-body">

                <section class="admin-book-section">
                    <div class="admin-book-section-header">
                        <h4>Informações Básicas</h4>
                        <p>Os dados principais que identificam o livro no catálogo.</p>
                    </div>

                    <div class="admin-grid-2">

                        <div class="admin-form-group">
                            <label>Título</label>
                            <input name="Titulo" class="admin-input" required>
                        </div>

                        <div class="admin-form-group">
                            <label>Autor</label>
                            <input name="Autor" class="admin-input" required>
                        </div>

                        <div class="admin-form-group">
                            <label>Ano</label>
                            <input type="number"
                                   name="Ano"
                                   class="admin-input"
                                   min="1000"
                                   max="2100">
                        </div>

                        <div class="admin-form-group">
                            <label>Editora</label>
                            <input name="Editora" class="admin-input">
                        </div>

                        <div class="admin-form-group">
                            <label>Edição</label>
                            <input name="Edicao" class="admin-input">
                        </div>

                        <div class="admin-form-group admin-form-group-full">
                            <label>Categorias</label>
                            <select name="categoriasIds" class="admin-input admin-multiselect" multiple size="6" required>
                                @foreach (var categoria in categoriasDisponiveis) {
                                    <option value="@categoria.Id">@categoria.Nome</option>
                                }
                            </select>
                            <small class="quantity-help">Segure Ctrl para selecionar mais de uma categoria.</small>
                        </div>
                    </div>
                </section>

                <section class="admin-book-section">
                    <div class="admin-book-section-header">
                        <h4>Identificação</h4>
                        <p>Códigos usados para consulta, venda e controle do exemplar.</p>
                    </div>

                    <div class="admin-grid-2">
                        <div class="admin-form-group">
                            <label>ISBN</label>
                            <input name="ISBN"
                                   class="admin-input"
                                   maxlength="13"
                                   pattern="\d{13}"
                                   title="ISBN deve ter 13 números">
                        </div>

                        <div class="admin-form-group">
                            <label>Código de Barras</label>
                            <input name="CodigoBarras"
                                   class="admin-input"
                                   maxlength="13"
                                   pattern="\d{13}"
                                   title="Código de barras deve ter 13 números">
                        </div>
                    </div>
                </section>

                <section class="admin-book-section">
                    <div class="admin-book-section-header">
                        <h4>Dimensões</h4>
                        <p>Medidas físicas do livro para logística e apresentação.</p>
                    </div>

                    <div class="admin-grid-4">
                        <div class="admin-form-group">
                            <label>Altura</label>
                            <input type="text" inputmode="decimal" name="Altura" class="admin-input" placeholder="Ex.: 22,5">
                        </div>

                        <div class="admin-form-group">
                            <label>Largura</label>
                            <input type="text" inputmode="decimal" name="Largura" class="admin-input" placeholder="Ex.: 15,4">
                        </div>

                        <div class="admin-form-group">
                            <label>Peso</label>
                            <input type="text" inputmode="decimal" name="Peso" class="admin-input" placeholder="Ex.: 0,34">
                        </div>

                        <div class="admin-form-group">
                            <label>Profundidade</label>
                            <input type="text" inputmode="decimal" name="Profundidade" class="admin-input" placeholder="Ex.: 2,0">
                        </div>
                    </div>
                </section>

                <section class="admin-book-section">
                    <div class="admin-book-section-header">
                        <h4>Detalhes</h4>
                        <p>Informações comerciais e de conteúdo que aparecem na loja.</p>
                    </div>

                    <div class="admin-grid-2">
                        <div class="admin-form-group">
                            <label>Páginas</label>
                            <input type="number"
                                   name="NumeroPaginas"
                                   class="admin-input"
                                   min="1"
                                   max="10000">
                        </div>

                        <div class="admin-form-group">
                            <label>Preço</label>
                            <input type="text"
                                   inputmode="decimal"
                                   name="Preco"
                                   class="admin-input"
                                   placeholder="Ex.: 29,90">
                        </div>

                        <div class="admin-form-group admin-form-group-full">
                            <label>Imagem da capa</label>
                            <input type="file" name="ImagemArquivo" class="admin-input">
                        </div>
                    </div>

                    <div class="admin-form-group admin-book-textarea">
                        <label>Sinopse</label>
                        <textarea name="Sinopse" class="admin-input" placeholder="Descreva o livro de forma objetiva para a vitrine e a página de detalhes."></textarea>
                    </div>
                </section>

            </div>

            <div class="admin-modal-footer">
                <button type="button" class="btn-secondary" onclick="fecharModalNovoLivro()">
                    Cancelar
                </button>

                <button type="submit" class="btn-primary">
                    Salvar
                </button>
            </div>

        </form>

    </div>
</div>

<script>
    function abrirModalNovoLivro() {
        document.getElementById("novoLivroModal").style.display = "flex";
    }

    function fecharModalNovoLivro() {
        document.getElementById("novoLivroModal").style.display = "none";
    }
</script>

