@model Livros.Web.Models.ViewModels.AdminLivrosViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Livros";
}
@if (TempData["Erro"] != null) {
    <div class="alert-error">
        @TempData["Erro"]
    </div>
}
@if (TempData["Sucesso"] != null) {
    <div class="alert-success">
        @TempData["Sucesso"]
    </div>
}

<div class="admin-page-header">
    <h2>Livros</h2>

    <button class="btn-primary" onclick="abrirModalNovoLivro()">
        + Novo Livro
    </button>
</div>

<form asp-action="Livros" method="get" class="admin-filters-card">
    <input type="text"
           name="busca"
           value="@Model.Busca"
           class="admin-input"
           placeholder="Buscar por titulo, autor, ISBN ou categoria..." />

    <select name="categoriaId" class="admin-select">
        <option value="">Todas categorias</option>
        @foreach (var categoria in Model.CategoriasDisponiveis) {
            if (Model.CategoriaId == categoria.Id) {
                <option value="@categoria.Id" selected>@categoria.Nome</option>
            }
            else {
                <option value="@categoria.Id">@categoria.Nome</option>
            }
        }
    </select>

    <select name="status" class="admin-select">
        @if (Model.Status == "ativos") {
            <option value="ativos" selected>Ativos</option>
        }
        else {
            <option value="ativos">Ativos</option>
        }

        @if (Model.Status == "inativos") {
            <option value="inativos" selected>Inativos</option>
        }
        else {
            <option value="inativos">Inativos</option>
        }

        @if (Model.Status == "todos") {
            <option value="todos" selected>Todos</option>
        }
        else {
            <option value="todos">Todos</option>
        }
    </select>

    <button type="submit" class="btn-primary">Filtrar</button>
    <a asp-action="Livros" class="btn-secondary">Limpar</a>
</form>

<div class="admin-table-wrapper">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Titulo</th>
                <th>Autor</th>
                <th>Categorias</th>
                <th>ISBN</th>
                <th>Status</th>
                <th>Acoes</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Livros.Any()) {
                <tr>
                    <td colspan="7" style="text-align:center;">
                        Nenhum livro encontrado para os filtros informados.
                    </td>
                </tr>
            }
            else {
                @foreach (var livro in Model.Livros) {
                    <tr>
                        <td>@livro.Id</td>
                        <td>@livro.Titulo</td>
                        <td>@livro.Autor</td>
                        <td>
                            @if (livro.Categorias != null && livro.Categorias.Any()) {
                                <div class="admin-tag-list">
                                    @foreach (var categoria in livro.Categorias.OrderBy(c => c.Nome)) {
                                        <span class="admin-tag">@categoria.Nome</span>
                                    }
                                </div>
                            }
                            else {
                                <span class="admin-muted">Sem categoria</span>
                            }
                        </td>
                        <td>@livro.ISBN</td>
                        <td>
                            @if (livro.IsAtivo) {
                                <span class="status success">Ativo</span>
                            }
                            else {
                                <span class="status danger">Inativo</span>
                            }
                        </td>
                        <td>
                            <button type="button"
                                    class="btn-secondary"
                                    onclick="abrirModalEditarCategorias(@livro.Id)">
                                Editar categorias
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@foreach (var livro in Model.Livros) {
    var categoriasSelecionadas = livro.Categorias?.Select(c => c.Id).ToHashSet() ?? new HashSet<int>();

    <div class="admin-modal-overlay" id="editarCategoriasModal-@livro.Id" style="display:none;">
        <div class="admin-modal">
            <div class="admin-modal-header">
                <div>
                    <span class="admin-modal-kicker">Catalogo</span>
                    <h3>Editar categorias</h3>
                </div>
                <button class="modal-close" type="button" aria-label="Fechar modal" onclick="fecharModalEditarCategorias(@livro.Id)">×</button>
            </div>

            <form asp-action="EditarCategoriasLivro" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="livroId" value="@livro.Id" />
                <input type="hidden" name="busca" value="@Model.Busca" />
                <input type="hidden" name="categoriaId" value="@Model.CategoriaId" />
                <input type="hidden" name="status" value="@Model.Status" />

                <div class="admin-modal-body">
                    <div class="admin-form-group">
                        <label>Livro</label>
                        <input class="admin-input" value="@livro.Titulo" readonly>
                    </div>

                    <div class="admin-form-group">
                        <label>Categorias</label>
                        <select name="categoriasIds" class="admin-input admin-multiselect" multiple size="8" required>
                            @foreach (var categoria in Model.CategoriasDisponiveis) {
                                if (categoriasSelecionadas.Contains(categoria.Id)) {
                                    <option value="@categoria.Id" selected>@categoria.Nome</option>
                                }
                                else {
                                    <option value="@categoria.Id">@categoria.Nome</option>
                                }
                            }
                        </select>
                        <small class="quantity-help">Segure Ctrl para selecionar mais de uma categoria.</small>
                    </div>
                </div>

                <div class="admin-modal-footer">
                    <button type="button" class="btn-secondary" onclick="fecharModalEditarCategorias(@livro.Id)">
                        Cancelar
                    </button>
                    <button type="submit" class="btn-primary">
                        Salvar categorias
                    </button>
                </div>
            </form>
        </div>
    </div>
}

<div class="admin-modal-overlay" id="novoLivroModal" style="display:none;">
    <div class="admin-modal large admin-book-modal">
        <div class="admin-modal-header admin-book-modal-header">
            <div>
                <span class="admin-modal-kicker">Catalogo</span>
                <h3>Novo Livro</h3>
            </div>
            <button class="modal-close" type="button" aria-label="Fechar modal" onclick="fecharModalNovoLivro()">×</button>
        </div>

        <form asp-action="CriarLivro" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="busca" value="@Model.Busca" />
            <input type="hidden" name="categoriaId" value="@Model.CategoriaId" />
            <input type="hidden" name="status" value="@Model.Status" />

            <div class="admin-modal-body admin-book-modal-body">
                <section class="admin-book-section">
                    <div class="admin-book-section-header">
                        <h4>Informacoes basicas</h4>
                        <p>Os dados principais que identificam o livro no catalogo.</p>
                    </div>

                    <div class="admin-grid-2">
                        <div class="admin-form-group">
                            <label>Titulo</label>
                            <input name="Titulo" class="admin-input" required>
                        </div>

                        <div class="admin-form-group">
                            <label>Autor</label>
                            <input name="Autor" class="admin-input" required>
                        </div>

                        <div class="admin-form-group">
                            <label>Ano</label>
                            <input type="number" name="Ano" class="admin-input" min="1000" max="2100">
                        </div>

                        <div class="admin-form-group">
                            <label>Editora</label>
                            <input name="Editora" class="admin-input">
                        </div>

                        <div class="admin-form-group">
                            <label>Edicao</label>
                            <input name="Edicao" class="admin-input">
                        </div>

                        <div class="admin-form-group admin-form-group-full">
                            <label>Categorias</label>
                            <select name="categoriasIds" class="admin-input admin-multiselect" multiple size="6" required>
                                @foreach (var categoria in Model.CategoriasDisponiveis) {
                                    <option value="@categoria.Id">@categoria.Nome</option>
                                }
                            </select>
                            <small class="quantity-help">Segure Ctrl para selecionar mais de uma categoria.</small>
                        </div>
                    </div>
                </section>

                <section class="admin-book-section">
                    <div class="admin-book-section-header">
                        <h4>Identificacao</h4>
                        <p>Codigos usados para consulta, venda e controle do exemplar.</p>
                    </div>

                    <div class="admin-grid-2">
                        <div class="admin-form-group">
                            <label>ISBN</label>
                            <input name="ISBN" class="admin-input" maxlength="13" pattern="\d{13}" title="ISBN deve ter 13 numeros">
                        </div>

                        <div class="admin-form-group">
                            <label>Codigo de Barras</label>
                            <input name="CodigoBarras" class="admin-input" maxlength="13" pattern="\d{13}" title="Codigo de barras deve ter 13 numeros">
                        </div>
                    </div>
                </section>

                <section class="admin-book-section">
                    <div class="admin-book-section-header">
                        <h4>Dimensoes</h4>
                        <p>Medidas fisicas do livro para logistica e apresentacao.</p>
                    </div>

                    <div class="admin-grid-4">
                        <div class="admin-form-group">
                            <label>Altura</label>
                            <input type="text" inputmode="decimal" name="Altura" class="admin-input" placeholder="Ex.: 22,5">
                        </div>

                        <div class="admin-form-group">
                            <label>Largura</label>
                            <input type="text" inputmode="decimal" name="Largura" class="admin-input" placeholder="Ex.: 15,4">
                        </div>

                        <div class="admin-form-group">
                            <label>Peso</label>
                            <input type="text" inputmode="decimal" name="Peso" class="admin-input" placeholder="Ex.: 0,34">
                        </div>

                        <div class="admin-form-group">
                            <label>Profundidade</label>
                            <input type="text" inputmode="decimal" name="Profundidade" class="admin-input" placeholder="Ex.: 2,0">
                        </div>
                    </div>
                </section>

                <section class="admin-book-section">
                    <div class="admin-book-section-header">
                        <h4>Detalhes</h4>
                        <p>Informacoes comerciais e de conteudo que aparecem na loja.</p>
                    </div>

                    <div class="admin-grid-2">
                        <div class="admin-form-group">
                            <label>Paginas</label>
                            <input type="number" name="NumeroPaginas" class="admin-input" min="1" max="10000">
                        </div>

                        <div class="admin-form-group">
                            <label>Preco</label>
                            <input type="text" inputmode="decimal" name="Preco" class="admin-input" placeholder="Ex.: 29,90">
                        </div>

                        <div class="admin-form-group admin-form-group-full">
                            <label>Imagem da capa</label>
                            <input type="file" name="ImagemArquivo" class="admin-input">
                        </div>
                    </div>

                    <div class="admin-form-group admin-book-textarea">
                        <label>Sinopse</label>
                        <textarea name="Sinopse" class="admin-input" placeholder="Descreva o livro de forma objetiva para a vitrine e a pagina de detalhes."></textarea>
                    </div>
                </section>
            </div>

            <div class="admin-modal-footer">
                <button type="button" class="btn-secondary" onclick="fecharModalNovoLivro()">
                    Cancelar
                </button>

                <button type="submit" class="btn-primary">
                    Salvar
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirModalNovoLivro() {
        document.getElementById("novoLivroModal").style.display = "flex";
    }

    function fecharModalNovoLivro() {
        document.getElementById("novoLivroModal").style.display = "none";
    }

    function abrirModalEditarCategorias(livroId) {
        document.getElementById(`editarCategoriasModal-${livroId}`).style.display = "flex";
    }

    function fecharModalEditarCategorias(livroId) {
        document.getElementById(`editarCategoriasModal-${livroId}`).style.display = "none";
    }
</script>
