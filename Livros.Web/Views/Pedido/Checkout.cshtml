@model CheckoutViewModel

<section class="checkout-page">
    <div class="container">
        <form asp-action="FinalizarPedido" method="post" onsubmit="return validarPagamento()">
            <h2>Finalizar Compra</h2>

            <div class="checkout-layout">

                <!-- FORM -->
                <div class="checkout-form">

                    <!-- ENDEREÇO -->
                    <h3>Endereço de Entrega</h3>

                    <div class="address-grid">
                        @if (Model.Enderecos != null && Model.Enderecos.Any()) {
                            foreach (var endereco in Model.Enderecos) {
                                <div class="address-card" onclick="selecionarEndereco(@endereco.Id, this)">

                                    <input type="radio" name="EnderecoId" value="@endereco.Id" hidden />

                                    <h4>@endereco.NomeEndereco</h4>

                                    <p>@endereco.Logradouro, @endereco.Numero</p>
                                    <p>@endereco.Bairro.Nome - @endereco.Cidade.Nome/@endereco.Cidade.Estado.Sigla</p>
                                    <p>CEP: @endereco.CEP</p>

                                </div>
                            }
                        }
                        else {
                            <p>Nenhum endereço encontrado.</p>
                        }

                        <div class="address-card novo-endereco" onclick="selecionarNovoEndereco(this)">
                            <strong>+ Novo Endereço</strong>

                            <input type="radio" name="EnderecoId" value="0" hidden />
                        </div>

                    </div>

                    <div id="novoEnderecoForm" class="card checkout-card" style="display:none;">
                        <div class="checkout-address-grid">

                            <input name="CEP" maxlength="9" placeholder="CEP">
                            <input name="Logradouro" maxlength="100" placeholder="Logradouro">

                            <input name="Numero" maxlength="10" placeholder="Número">
                            <input name="Complemento" maxlength="50" placeholder="Complemento">
                            
                            <input name="Bairro" maxlength="50" placeholder="Bairro">
                            
                            <input name="Cidade" maxlength="50" placeholder="Cidade">
                            <input name="Estado" maxlength="2" placeholder="Estado">

                        </div>
                    </div>

                    <!-- PAGAMENTO -->
                    <div class="payment-section card">

                        <h3>Forma de Pagamento</h3>

                        <!-- MÉTODO 1 -->
                        <div class="payment-block">
                            <h4>Pagamento 1</h4>

                            <select name="Metodo1" onchange="togglePagamento(this.value, 1)">
                                <option value="">Selecione</option>
                                <option value="pix">Pix</option>
                                <option value="boleto">Boleto</option>
                                <option value="cartao">Cartão</option>
                            </select>

                            <input type="number" name="Valor1" placeholder="Valor" step="0.01">

                            <!-- CARTÃO -->
                            <div id="cartaoForm1" class="cartao-form" style="display:none;">
                                <input name="NumeroCartao1" maxlength="16" placeholder="Número do Cartão">
                                <input name="NomeCartao1" maxlength="100" placeholder="Nome Impresso no Cartão">
                                <input name="CVV1" maxlength="3" placeholder="CVV">
                                <input name="Validade1" maxlength="5" placeholder="MM/AA" placeholder="Validade do Cartão">
                            </div>
                        </div>

                        <hr>

                        <!-- MÉTODO 2 -->
                        <div class="payment-block">
                            <h4>Pagamento 2 (opcional)</h4>

                            <select name="Metodo2" onchange="togglePagamento(this.value, 2)">
                                <option value="">Nenhum</option>
                                <option value="pix">Pix</option>
                                <option value="boleto">Boleto</option>
                                <option value="cartao">Cartão</option>
                            </select>

                            <input type="number" name="Valor2" placeholder="Valor" step="0.01">

                            <div id="cartaoForm2" class="cartao-form" style="display:none;">
                                <input name="NumeroCartao2" maxlength="16" placeholder="Número do Cartão">
                                <input name="NomeCartao2" maxlength="100" placeholder="Nome Impresso no Cartão">
                                <input name="CVV2" maxlength="3" placeholder="CVV">
                                <input name="Validade2" maxlength="5" placeholder="MM/AA">
                            </div>
                        </div>

                    </div>

                </div>

                <!-- RESUMO -->
                <div class="checkout-summary card">

                    <h3>Resumo do pedido</h3>

                    <p>
                        Produto:
                        <strong>@Model.Livro.Titulo</strong>
                    </p>

                    <p>
                        Subtotal:
                        <strong>R$ @Model.Livro.Preco.ToString("N2")</strong>
                    </p>

                    <p>
                        Frete:
                        <strong id="freteValor">R$ 0,00</strong>
                    </p>

                    <hr>

                    <p class="total-price">
                        Total:
                        R$ <span id="totalCompra">@Model.Livro.Preco.ToString("N2")</span>
                    </p>

                    <label>Quantidade:</label>
                    <input type="number" id="quantidade" name="Quantidade" value="@Model.Quantidade" min="1">
                    <!-- CEP FRETE -->
                    <input id="cepFrete" maxlength="8" placeholder="Digite o CEP">
                    <button type="button" class="btn btn-secondary" onclick="calcularFrete()">Calcular Frete</button>

                    <!-- CUPOM -->
                    <input id="cupom" placeholder="Cupom de desconto">
                    <button type="button" class="btn btn-secondary" onclick="aplicarCupom()">Aplicar</button>


                    <button type="submit" class="btn btn-primary btn-block">
                        Finalizar pagamento
                    </button>

                </div>

            </div>
        </form>
    </div>
</section>

<script src="~/assets/js/checkout.js"></script>