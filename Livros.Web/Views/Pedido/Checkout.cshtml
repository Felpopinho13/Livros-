@model CheckoutViewModel

@{
    var form = Model.Form;
    var segundoPagamentoAtivo = !string.IsNullOrWhiteSpace(form.Metodo2);
    var entregaProgramadaSelecionada = string.Equals(form.TipoEntrega, "PROGRAMADA", System.StringComparison.OrdinalIgnoreCase);
    var dataMinimaEntregaProgramada = DateTime.Today.AddDays(7).ToString("yyyy-MM-dd");
}

<section class="checkout-page">
    <div class="container">
        <form asp-action="FinalizarPedido" method="post" class="checkout-form-root">
            @Html.AntiForgeryToken()
            <input type="hidden" name="LivroId" value="@form.LivroId" />
            <input type="hidden" name="UsarCarrinho" value="@form.UsarCarrinho.ToString().ToLower()" />

            <h2>Finalizar Compra</h2>

            @if (TempData["Sucesso"] != null) {
                <div class="checkout-feedback success">@TempData["Sucesso"]</div>
            }

            @if (!ViewData.ModelState.IsValid) {
                <div class="checkout-feedback error">
                    @foreach (var erro in ViewData.ModelState.Values.SelectMany(v => v.Errors)) {
                        <div>@erro.ErrorMessage</div>
                    }
                </div>
            }

            @if (Model.AvisosCarrinho.Any()) {
                <div class="checkout-feedback warning">
                    @foreach (var aviso in Model.AvisosCarrinho.Distinct()) {
                        <div>@aviso</div>
                    }
                </div>
            }

            <div class="checkout-layout"
                 data-unit-price="@((Model.PermiteAlterarQuantidade && Model.Livro != null ? Model.Livro.Preco : 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                 data-subtotal-base="@Model.Subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 data-quantidade-base="@Model.Quantidade"
                 data-permite-quantidade="@Model.PermiteAlterarQuantidade.ToString().ToLower()"
                 data-frete="@Model.Frete.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 data-frete-url="@Url.Action("CalcularFreteCheckout", "Pedido")"
                 data-cupom="DESCONTO10">
                <div class="checkout-form">
                    <div class="card checkout-card">
                        <h3>Endereco de Entrega</h3>

                        <div class="address-grid">
                            @foreach (var endereco in Model.Enderecos) {
                                var selected = form.EnderecoId == endereco.Id;

                                <label class="address-card @(selected ? "selected" : "")">
                                    <input type="radio" name="EnderecoId" value="@endereco.Id" data-estado="@endereco.Cidade.Estado.Sigla" @(selected ? "checked" : "") />
                                    <h4>@endereco.NomeEndereco</h4>
                                    <p>@endereco.Logradouro, @endereco.Numero</p>
                                    <p>@endereco.Bairro.Nome - @endereco.Cidade.Nome/@endereco.Cidade.Estado.Sigla</p>
                                    <p>CEP: @endereco.CEP</p>
                                </label>
                            }

                            <label class="address-card novo-endereco @(form.EnderecoId == 0 ? "selected" : "")">
                                <input type="radio" name="EnderecoId" value="0" data-estado="@form.Estado" @(form.EnderecoId == 0 ? "checked" : "") />
                                <strong>+ Novo Endereco</strong>
                                <span>Cadastre um endereco para esta compra.</span>
                            </label>
                        </div>

                        <div id="novoEnderecoForm" class="checkout-card-inner" style="@(form.EnderecoId == 0 ? "display:block;" : "display:none;")">
                            <div class="checkout-address-grid">
                                <input name="NomeEndereco" maxlength="60" placeholder="Nome do endereco" value="@form.NomeEndereco">
                                <input name="CEP" maxlength="9" minlength="8" inputmode="numeric" pattern="[0-9]{5}-?[0-9]{3}" placeholder="CEP (8 dÃ­gitos)" value="@form.CEP">
                                <input name="Logradouro" maxlength="100" placeholder="Logradouro" value="@form.Logradouro">
                                <input name="Numero" maxlength="10" placeholder="Numero" value="@form.Numero">
                                <input name="Complemento" maxlength="50" placeholder="Complemento" value="@form.Complemento">
                                <input name="Bairro" maxlength="50" placeholder="Bairro" value="@form.Bairro">
                                <input name="Cidade" maxlength="50" placeholder="Cidade" value="@form.Cidade">
                                <input id="estadoNovoEndereco" name="Estado" maxlength="2" minlength="2" pattern="[A-Za-z]{2}" placeholder="UF" value="@form.Estado">
                            </div>

                            <label class="checkout-checkbox">
                                <input type="checkbox" name="SalvarNovoEndereco" value="true" @(form.SalvarNovoEndereco ? "checked" : "")>
                                <span>Salvar este endereco no meu perfil</span>
                            </label>
                        </div>

                        <div class="checkout-card-inner checkout-delivery-panel">
                            <div class="checkout-delivery-header">
                                <label for="tipoEntrega">Tipo de entrega</label>
                            </div>
                            <select id="tipoEntrega" name="TipoEntrega" class="admin-select">
                                @if (string.Equals(form.TipoEntrega, "PROGRAMADA", System.StringComparison.OrdinalIgnoreCase)) {
                                    <option value="PADRAO">Entrega padrão</option>
                                    <option value="PROGRAMADA" selected>Entrega programada</option>
                                }
                                else {
                                    <option value="PADRAO" selected>Entrega padrão</option>
                                    <option value="PROGRAMADA">Entrega programada</option>
                                }
                            </select>

                            <div id="dataEntregaProgramadaWrapper"
                                 class="checkout-scheduled-delivery @(entregaProgramadaSelecionada ? "is-visible" : string.Empty)"
                                 style="@(entregaProgramadaSelecionada ? string.Empty : "display:none;")">
                                <label for="dataEntregaPrevista">Data da entrega programada</label>
                                <input id="dataEntregaPrevista"
                                       name="DataEntregaPrevista"
                                       type="date"
                                       min="@dataMinimaEntregaProgramada"
                                       value="@(form.DataEntregaPrevista?.ToString("yyyy-MM-dd"))">
                                @Html.ValidationMessage("DataEntregaPrevista", null, new { @class = "checkout-field-error" })
                            </div>
                        </div>
                    </div>

                    <div class="payment-section card">
                        <h3>Forma de Pagamento</h3>
                        <p class="checkout-hint">Voce pode dividir o valor em ate 2 pagamentos.</p>

                        <div class="payment-block" data-payment-index="1">
                            <h4>Pagamento 1</h4>

                            <select name="Metodo1" class="payment-method-select" data-index="1">
                                @if (string.IsNullOrWhiteSpace(form.Metodo1)) {
                                    <option value="" selected>Selecione</option>
                                }
                                else {
                                    <option value="">Selecione</option>
                                }

                                @if (form.Metodo1 == "pix") {
                                    <option value="pix" selected>Pix</option>
                                }
                                else {
                                    <option value="pix">Pix</option>
                                }

                                @if (form.Metodo1 == "boleto") {
                                    <option value="boleto" selected>Boleto</option>
                                }
                                else {
                                    <option value="boleto">Boleto</option>
                                }

                                @if (form.Metodo1 == "cartao") {
                                    <option value="cartao" selected>Cartao</option>
                                }
                                else {
                                    <option value="cartao">Cartao</option>
                                }
                            </select>

                            <input type="text" name="Valor1" placeholder="Valor" inputmode="decimal" value="@(form.Valor1?.ToString("N2"))">

                            <div id="cartaoForm1" class="cartao-form" style="@(form.Metodo1 == "cartao" ? "display:grid;" : "display:none;")">
                                <select name="CartaoId1" class="saved-card-select" data-index="1">
                                    @if (!form.CartaoId1.HasValue || form.CartaoId1.Value == 0) {
                                        <option value="" selected>Novo cartao</option>
                                    }
                                    else {
                                        <option value="">Novo cartao</option>
                                    }

                                    @foreach (var cartao in Model.Cartoes) {
                                        var selecionado = form.CartaoId1 == cartao.Id;
                                        var numeroFinal = cartao.Numero?.Length >= 4 ? cartao.Numero.Substring(cartao.Numero.Length - 4) : cartao.Numero;

                                        if (selecionado) {
                                            <option value="@cartao.Id" selected>@cartao.BandeiraCartao?.Nome - @cartao.NomeImpresso - **** @numeroFinal</option>
                                        }
                                        else {
                                            <option value="@cartao.Id">@cartao.BandeiraCartao?.Nome - @cartao.NomeImpresso - **** @numeroFinal</option>
                                        }
                                    }
                                </select>

                                <div id="novoCartaoForm1" class="new-card-fields" style="@((form.CartaoId1.HasValue && form.CartaoId1.Value > 0) ? "display:none;" : "display:grid;")">
                                    <select name="BandeiraCartaoId1">
                                        <option value="">Selecione a bandeira</option>
                                        @foreach (var bandeira in Model.Bandeiras) {
                                            if (form.BandeiraCartaoId1 == bandeira.Id) {
                                                <option value="@bandeira.Id" selected>@bandeira.Nome</option>
                                            }
                                            else {
                                                <option value="@bandeira.Id">@bandeira.Nome</option>
                                            }
                                        }
                                    </select>
                                    <input name="NomeCartao1" maxlength="100" placeholder="Nome impresso" value="@form.NomeCartao1">
                                    <input name="NumeroCartao1" maxlength="16" minlength="16" inputmode="numeric" pattern="[0-9]{16}" placeholder="Numero do cartao (16 dÃ­gitos)" value="@form.NumeroCartao1">
                                    <input name="CVV1" maxlength="3" minlength="3" inputmode="numeric" pattern="[0-9]{3}" placeholder="CVV" value="@form.CVV1">
                                    <input name="Validade1" maxlength="5" minlength="5" pattern="(0[1-9]|1[0-2])/[0-9]{2}" placeholder="MM/AA" value="@form.Validade1">

                                    <label class="checkout-checkbox checkbox-inline">
                                        <input type="checkbox" name="SalvarNovoCartao1" value="true" @(form.SalvarNovoCartao1 ? "checked" : "")>
                                        <span>Salvar este cartao</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <button type="button"
                                id="toggleSegundoPagamento"
                                class="btn btn-secondary checkout-second-payment-toggle"
                                aria-expanded="@segundoPagamentoAtivo.ToString().ToLower()">
                            @(segundoPagamentoAtivo ? "Remover segundo meio de pagamento" : "Adicionar segundo meio de pagamento")
                        </button>

                        <div id="segundoPagamentoWrapper" class="checkout-second-payment-wrapper" style="@(segundoPagamentoAtivo ? "display:block;" : "display:none;")">
                            <hr>

                            <div class="payment-block" data-payment-index="2">
                                <h4>Pagamento 2 (opcional)</h4>

                                <select name="Metodo2" class="payment-method-select" data-index="2">
                                    @if (string.IsNullOrWhiteSpace(form.Metodo2)) {
                                        <option value="" selected>Nenhum</option>
                                    }
                                    else {
                                        <option value="">Nenhum</option>
                                    }

                                    @if (form.Metodo2 == "pix") {
                                        <option value="pix" selected>Pix</option>
                                    }
                                    else {
                                        <option value="pix">Pix</option>
                                    }

                                    @if (form.Metodo2 == "boleto") {
                                        <option value="boleto" selected>Boleto</option>
                                    }
                                    else {
                                        <option value="boleto">Boleto</option>
                                    }

                                    @if (form.Metodo2 == "cartao") {
                                        <option value="cartao" selected>Cartao</option>
                                    }
                                    else {
                                        <option value="cartao">Cartao</option>
                                    }
                                </select>

                                <input type="text" name="Valor2" placeholder="Valor" inputmode="decimal" value="@(form.Valor2?.ToString("N2"))">

                                <div id="cartaoForm2" class="cartao-form" style="@(form.Metodo2 == "cartao" ? "display:grid;" : "display:none;")">
                                    <select name="CartaoId2" class="saved-card-select" data-index="2">
                                        @if (!form.CartaoId2.HasValue || form.CartaoId2.Value == 0) {
                                            <option value="" selected>Novo cartao</option>
                                        }
                                        else {
                                            <option value="">Novo cartao</option>
                                        }

                                        @foreach (var cartao in Model.Cartoes) {
                                            var selecionado = form.CartaoId2 == cartao.Id;
                                            var numeroFinal = cartao.Numero?.Length >= 4 ? cartao.Numero.Substring(cartao.Numero.Length - 4) : cartao.Numero;

                                            if (selecionado) {
                                                <option value="@cartao.Id" selected>@cartao.BandeiraCartao?.Nome - @cartao.NomeImpresso - **** @numeroFinal</option>
                                            }
                                            else {
                                                <option value="@cartao.Id">@cartao.BandeiraCartao?.Nome - @cartao.NomeImpresso - **** @numeroFinal</option>
                                            }
                                        }
                                    </select>

                                    <div id="novoCartaoForm2" class="new-card-fields" style="@((form.CartaoId2.HasValue && form.CartaoId2.Value > 0) ? "display:none;" : "display:grid;")">
                                        <select name="BandeiraCartaoId2">
                                            <option value="">Selecione a bandeira</option>
                                            @foreach (var bandeira in Model.Bandeiras) {
                                                if (form.BandeiraCartaoId2 == bandeira.Id) {
                                                    <option value="@bandeira.Id" selected>@bandeira.Nome</option>
                                                }
                                                else {
                                                    <option value="@bandeira.Id">@bandeira.Nome</option>
                                                }
                                            }
                                        </select>
                                        <input name="NomeCartao2" maxlength="100" placeholder="Nome impresso" value="@form.NomeCartao2">
                                        <input name="NumeroCartao2" maxlength="16" minlength="16" inputmode="numeric" pattern="[0-9]{16}" placeholder="Numero do cartao (16 dÃ­gitos)" value="@form.NumeroCartao2">
                                        <input name="CVV2" maxlength="3" minlength="3" inputmode="numeric" pattern="[0-9]{3}" placeholder="CVV" value="@form.CVV2">
                                        <input name="Validade2" maxlength="5" minlength="5" pattern="(0[1-9]|1[0-2])/[0-9]{2}" placeholder="MM/AA" value="@form.Validade2">

                                        <label class="checkout-checkbox checkbox-inline">
                                            <input type="checkbox" name="SalvarNovoCartao2" value="true" @(form.SalvarNovoCartao2 ? "checked" : "")>
                                            <span>Salvar este cartao</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="checkout-summary card">
                    <h3>Resumo do pedido</h3>

                    @if (Model.OrigemCarrinho) {
                        <div class="checkout-items-list">
                            @foreach (var item in Model.Itens) {
                                <div class="checkout-item-row">
                                    <div>
                                        <strong>@item.Titulo</strong>
                                        <span>@item.Quantidade x R$ @item.PrecoUnitario.ToString("N2")</span>
                                    </div>
                                    <strong>R$ @item.TotalItem.ToString("N2")</strong>
                                </div>
                            }
                        </div>

                        <p>Total de itens: <strong>@Model.Quantidade</strong></p>
                    }
                    else if (Model.Livro != null) {
                        <p>Produto: <strong>@Model.Livro.Titulo</strong></p>
                        <p>Preco unitario: <strong>R$ @Model.Livro.Preco.ToString("N2")</strong></p>
                    }

                    @if (Model.PermiteAlterarQuantidade) {
                        <label for="quantidade">Quantidade:</label>
                        <input type="number" id="quantidade" name="Quantidade" value="@form.Quantidade" min="1">
                    }
                    else {
                        <input type="hidden" name="Quantidade" value="@form.Quantidade" />
                    }

                    <p>Subtotal: <strong id="subtotalValor">R$ @Model.Subtotal.ToString("N2")</strong></p>
                    <p>Frete: <strong id="freteValor">R$ @Model.Frete.ToString("N2")</strong></p>
                    <p>Desconto: <strong id="descontoValor">R$ @Model.Desconto.ToString("N2")</strong></p>

                    <input id="cupom" name="Cupom" placeholder="Cupom de desconto" value="@form.Cupom">
                    <button type="button" class="btn btn-secondary" id="aplicarCupomBtn">Aplicar cupom</button>

                    @if (Model.CuponsTrocaDisponiveis.Any()) {
                        <div class="checkout-coupons-wallet">
                            <p class="checkout-coupons-title">Cupons de troca disponiveis</p>
                            <p class="checkout-coupons-hint">
                                Selecione os cupons que deseja usar. O sistema escolhe automaticamente a melhor combinacao para evitar sobra desnecessaria.
                            </p>

                            <div class="checkout-coupons-list">
                                @foreach (var cupom in Model.CuponsTrocaDisponiveis) {
                                    var selecionado = form.CuponsTrocaSelecionados.Contains(cupom.Id);
                                    <label class="checkout-coupon-option">
                                        <input type="checkbox"
                                               name="CuponsTrocaSelecionados"
                                               value="@cupom.Id"
                                               @(selecionado ? "checked" : "")>
                                        <span>
                                            <strong>@cupom.Codigo</strong>
                                            <small>R$ @cupom.Valor.ToString("N2")</small>
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <div id="cupomMensagem" class="checkout-coupon-message" style="display:none;"></div>

                    <hr>

                    <p class="total-price">
                        Total:
                        R$ <span id="totalCompra">@Model.Total.ToString("N2")</span>
                    </p>

                    @if (Model.RequerRevisaoCarrinho) {
                        <div class="checkout-review-warning">
                            Revise o carrinho antes de concluir a compra. Houve alteracao de estoque ou expiracao da reserva.
                        </div>
                        <a asp-controller="Pedido" asp-action="Carrinho" class="btn btn-secondary btn-block">
                            Revisar carrinho
                        </a>
                    }
                    else {
                        <button type="submit" class="btn btn-primary btn-block">
                            Finalizar pagamento
                        </button>
                    }
                </div>
            </div>
        </form>
    </div>
</section>

<script src="~/assets/js/checkout.js"></script>





