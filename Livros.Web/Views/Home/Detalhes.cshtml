@model Livros.Web.Models.ViewModels.LivroDetalhesViewModel

@{
    var livro = Model.Livro;
    var estoqueDisponivel = livro.Estoque?.Quantidade ?? 0;
    var emEstoque = livro.IsAtivo && estoqueDisponivel > 0;
}

<section class="book-detail">
    <div class="container book-detail-grid">
        <div class="book-gallery">
            <img src="@livro.ImagemUrl" alt="@livro.Titulo">
        </div>

        <div class="book-info">
            <div class="book-title-row">
                <h1>@livro.Titulo</h1>

                <button
                    type="button"
                    class="btn-wishlist"
                    data-id="@livro.Id"
                    aria-label="Adicionar a lista de desejos"
                    aria-pressed="false">&#10084;</button>
            </div>

            <p class="author">por @livro.Autor</p>

            <div class="book-review-summary">
                @if (Model.PossuiAvaliacoes) {
                    <strong>@Model.MediaAvaliacoes.ToString("N1")/5</strong>
                    <span>com base em @Model.QuantidadeAvaliacoes avaliação(ões).</span>
                }
                else {
                    <span>Ainda sem avaliações de clientes.</span>
                }
            </div>

            @if (livro.Categorias != null && livro.Categorias.Any()) {
                <div class="book-category-list">
                    @foreach (var categoria in livro.Categorias.OrderBy(c => c.Nome)) {
                        <span class="book-category-tag">@categoria.Nome</span>
                    }
                </div>
            }

            <p class="description">
                @livro.Sinopse
            </p>

            <p><strong>Editora:</strong> @livro.Editora</p>
            <p><strong>Ano:</strong> @livro.Ano</p>
            <p><strong>Páginas:</strong> @livro.NumeroPaginas</p>
        </div>

        <div class="book-buy-box">
            <p class="price">
                R$ @livro.Preco.ToString("N2")
            </p>

            <p class="stock-summary @(emEstoque ? "in-stock" : "out-of-stock")">
                @(emEstoque ? $"{estoqueDisponivel} unidade(s) disponíveis em estoque" : "Indisponível no momento")
            </p>

            <label for="quantidade" class="quantity-label">Quantidade desejada</label>
            <input type="number"
                   id="quantidade"
                   value="@(emEstoque ? 1 : 0)"
                   min="1"
                   max="@(estoqueDisponivel > 0 ? estoqueDisponivel : 1)"
                   class="input"
                   @(emEstoque ? "" : "disabled")>
            <small class="quantity-help">
                Este campo indica quantos exemplares você quer comprar, não o total em estoque.
            </small>

            <form asp-controller="Pedido" asp-action="AdicionarAoCarrinho" method="post" id="formAdicionarCarrinho">
                @Html.AntiForgeryToken()
                <input type="hidden" name="livroId" value="@livro.Id" />
                <input type="hidden" name="quantidade" id="quantidadeCarrinho" value="@(emEstoque ? 1 : 0)" />
                <button type="submit" class="btn btn-primary btn-block" @(emEstoque ? "" : "disabled")>
                    Adicionar ao carrinho
                </button>
            </form>

            <a href="#" id="btnComprar" class="btn btn-block @(emEstoque ? "" : "btn-disabled")" aria-disabled="@(!emEstoque)">
                Comprar agora
            </a>

            <div class="payment-options">
                <h3>Formas de pagamento disponíveis</h3>
                <div class="payment-option-list">
                    <span>Cartão de crédito</span>
                    <span>2 cartões na mesma compra</span>
                    <span>Pix</span>
                    <span>Boleto</span>
                    <span>Cupom promocional</span>
                    <span>Cupom de troca</span>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.PossuiComentarios) {
    <section class="book-reviews-section">
        <div class="container">
            <div class="book-reviews-panel">
                <h2>Avaliações de leitores</h2>

                <div class="book-reviews-list">
                    @foreach (var comentario in Model.Comentarios.Where(item => !string.IsNullOrWhiteSpace(item.Comentario))) {
                        <article class="book-review-card">
                            <div class="book-review-card-header">
                                <strong>@comentario.NomeCliente</strong>
                                <span>@comentario.Nota/5</span>
                            </div>
                            <small>@comentario.DataAvaliacao.ToString("dd/MM/yyyy")</small>
                            <p>@comentario.Comentario</p>
                        </article>
                    }
                </div>
            </div>
        </div>
    </section>
}

<script>
    const quantidadeInput = document.getElementById("quantidade");
    const quantidadeCarrinho = document.getElementById("quantidadeCarrinho");
    const estoqueDisponivel = @estoqueDisponivel;

    if (quantidadeInput && quantidadeCarrinho) {
        quantidadeInput.addEventListener("input", function () {
            let quantidade = parseInt(quantidadeInput.value) || 1;

            if (quantidade < 1) quantidade = 1;
            if (estoqueDisponivel > 0 && quantidade > estoqueDisponivel) {
                quantidade = estoqueDisponivel;
            }

            quantidadeInput.value = quantidade;
            quantidadeCarrinho.value = quantidade;
        });
    }

    document.getElementById("btnComprar").addEventListener("click", function (e) {
        e.preventDefault();

        if (estoqueDisponivel <= 0) {
            return;
        }

        let quantidade = parseInt(quantidadeInput.value) || 1;

        if (quantidade < 1) quantidade = 1;
        if (quantidade > estoqueDisponivel) quantidade = estoqueDisponivel;

        let livroId = @livro.Id;

        window.location.href = `/Pedido/Checkout/${livroId}?quantidade=${quantidade}`;
    });
</script>
