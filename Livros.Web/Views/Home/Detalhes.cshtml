@model Livros.Domain.Livro

<section class="book-detail">
    <div class="container book-detail-grid">

        <div class="book-gallery">
            <img src="@Model.ImagemUrl" alt="@Model.Titulo">
        </div>

        <div class="book-info">
            <div class="book-title-row">
                <h1>@Model.Titulo</h1>

                <button class="btn-wishlist">
                    ❤
                </button>
            </div>

            <p class="author">por @Model.Autor</p>

            <p class="description">
                @Model.Sinopse
            </p>

            <p><strong>Editora:</strong> @Model.Editora</p>
            <p><strong>Ano:</strong> @Model.Ano</p>
            <p><strong>Páginas:</strong> @Model.NumeroPaginas</p>
        </div>

        <div class="book-buy-box">
            <p class="price">
                R$ @Model.Preco.ToString("N2")
            </p>

            <p class="stock">
                @(Model.IsAtivo ? "Em estoque" : "Indisponível")
            </p>

            <input type="number" id="quantidade" value="1" min="1" class="input">

            <form asp-controller="Pedido" asp-action="AdicionarAoCarrinho" method="post" id="formAdicionarCarrinho">
                @Html.AntiForgeryToken()
                <input type="hidden" name="livroId" value="@Model.Id" />
                <input type="hidden" name="quantidade" id="quantidadeCarrinho" value="1" />
                <button type="submit" class="btn btn-primary btn-block">
                    Adicionar ao carrinho
                </button>
            </form>

            <a href="#" id="btnComprar" class="btn btn-block">
                Comprar agora
            </a>

        </div>

    </div>
</section>

<script>
    const quantidadeInput = document.getElementById("quantidade");
    const quantidadeCarrinho = document.getElementById("quantidadeCarrinho");

    quantidadeInput.addEventListener("input", function () {
        let quantidade = parseInt(quantidadeInput.value) || 1;
        if (quantidade < 1) quantidade = 1;
        quantidadeCarrinho.value = quantidade;
    });

    document.getElementById("btnComprar").addEventListener("click", function (e) {
        e.preventDefault();

        let quantidade = parseInt(quantidadeInput.value) || 1;

        if (quantidade < 1) quantidade = 1;

        let livroId = @Model.Id;

        window.location.href = `/Pedido/Checkout/${livroId}?quantidade=${quantidade}`;
    });
</script>
