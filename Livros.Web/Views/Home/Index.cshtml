@model List<Livros.Domain.Livro>

<section class="banner">
    <div class="container">
        <h1>Descubra sua próxima leitura</h1>
        <p>Os melhores livros com os melhores preços</p>
    </div>
</section>

<section class="products">
    <div class="container">
        <h2>Destaques</h2>

        <div class="product-grid">

            @foreach (var livro in Model) {
                <div class="card product-card">

                    <img src="@livro.ImagemUrl" alt="Livro">

                    <a asp-controller="Home" asp-action="Detalhes" asp-route-id="@livro.Id">
                        <h3>@livro.Titulo</h3>
                    </a>

                    <p class="price">
                        R$ @livro.Preco.ToString("N2")
                    </p>

                    <button class="btn-wishlist">❤</button>

                    <button class="btn btn-primary btn-block">
                        Adicionar
                    </button>

                </div>
            }

        </div>
    </div>
</section>