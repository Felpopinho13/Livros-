@model List<Livros.Domain.Livro>

<section class="banner">
    <div class="container">
        <h1>Descubra sua proxima leitura</h1>
        <p>Os melhores livros com os melhores precos</p>
    </div>
</section>

<section class="products">
    <div class="container">
        <h2>Destaques</h2>

        @if (TempData["SucessoCarrinho"] != null) {
            <div class="checkout-feedback success">@TempData["SucessoCarrinho"]</div>
        }

        @if (TempData["ErroCarrinho"] != null) {
            <div class="checkout-feedback error">@TempData["ErroCarrinho"]</div>
        }

        <div class="product-grid">
            @foreach (var livro in Model) {
                <div class="card product-card">
                    <a asp-controller="Home" asp-action="Detalhes" asp-route-id="@livro.Id" class="product-image-link">
                        <img src="@livro.ImagemUrl" alt="@livro.Titulo">
                    </a>

                    <a asp-controller="Home" asp-action="Detalhes" asp-route-id="@livro.Id">
                        <h3>@livro.Titulo</h3>
                    </a>

                    @if (livro.Categorias != null && livro.Categorias.Any()) {
                        <div class="product-categories">
                            @foreach (var categoria in livro.Categorias.OrderBy(c => c.Nome).Take(2)) {
                                <span class="product-category-tag">@categoria.Nome</span>
                            }
                        </div>
                    }

                    <p class="price">
                        R$ @livro.Preco.ToString("N2")
                    </p>

                    <button class="btn-wishlist">❤</button>

                    <form asp-controller="Pedido" asp-action="AdicionarAoCarrinho" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="livroId" value="@livro.Id" />
                        <input type="hidden" name="quantidade" value="1" />
                        <button type="submit" class="btn btn-primary btn-block">
                            Adicionar ao carrinho
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</section>
