@model List<Endereco>

<section class="account-page">
    <div class="container account-layout">
        @await Html.PartialAsync("_AccountSidebar")

        <div class="account-content">
            <section class="address-page account-section-page">
                <div class="address-container">
                    @if (TempData["Erro"] != null) {
                        <div class="alert alert-error" style="margin-bottom: 16px;">
                            @TempData["Erro"]
                        </div>
                    }

                    @if (TempData["Sucesso"] != null) {
                        <div class="alert alert-success" style="margin-bottom: 16px;">
                            @TempData["Sucesso"]
                        </div>
                    }

                    <div class="breadcrumb">
                        <a asp-controller="Cliente" asp-action="AreaCliente">
                            Central Minha Conta
                        </a>
                        / <strong>Enderecos</strong>
                    </div>

                    <div class="address-header">
                        <h2>Enderecos</h2>

                        <button class="btn-primary" id="openModal">
                            + Cadastrar Novo Endereco
                        </button>
                    </div>

                    <div class="address-grid">
                        @foreach (var e in Model) {
                            <div class="address-card">
                                <div class="address-top">
                                    <h4>@e.NomeEndereco</h4>
                                    @if (e.IsPadrao) {
                                        <span class="badge">Padrao</span>
                                    }
                                </div>

                                <div class="address-purpose">
                                    @if (e.IsEntrega) {
                                        <span class="address-purpose-badge delivery">Entrega</span>
                                    }
                                    @if (e.IsCobranca) {
                                        <span class="address-purpose-badge billing">Cobranca</span>
                                    }
                                </div>

                                <div class="address-card-body">
                                    <p>@e.TipoResidencia - @e.TipoLogradouro @e.Logradouro, @e.Numero</p>
                                    <p>@e.Bairro.Nome - @e.Cidade.Nome/@e.Cidade.Estado.Sigla</p>
                                    <p>@e.Pais</p>
                                    <p>CEP: @e.CEP</p>
                                </div>

                                <div class="address-actions">
                                    <form asp-action="ExcluirEndereco" method="post" class="inline-action-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <button type="submit" class="btn-danger btn-sm"
                                                onclick="return confirm('Tem certeza que deseja excluir este endereco?');">
                                            Excluir
                                        </button>
                                    </form>

                                    <a asp-action="EditarEndereco" asp-route-id="@e.Id" class="btn-outline btn-sm">
                                        Editar
                                    </a>

                                    @if (!e.IsPadrao && e.IsEntrega) {
                                        <a asp-action="TornarPadrao" asp-route-id="@e.Id" class="make-default">
                                            Tornar padrao
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    </div>
</section>

<div class="modal-overlay" id="addressModal">
    <div class="modal">
        <h3>Novo Endereco</h3>

        <form asp-action="CadastrarEndereco" method="post">
            <input type="text" name="nomeEndereco" placeholder="Nome do endereco (Ex: Casa)" maxlength="50" required>
            <input type="text" name="cep" placeholder="CEP" maxlength="9" pattern="\d{5}-?\d{3}" required>

            <select name="tipoResidencia" required>
                <option value="Casa">Casa</option>
                <option value="Apartamento">Apartamento</option>
                <option value="Comercial">Comercial</option>
                <option value="Outro">Outro</option>
            </select>

            <select name="tipoLogradouro" required>
                <option value="Rua">Rua</option>
                <option value="Avenida">Avenida</option>
                <option value="Alameda">Alameda</option>
                <option value="Travessa">Travessa</option>
                <option value="Praca">Praca</option>
                <option value="Estrada">Estrada</option>
            </select>

            <input type="text" name="logradouro" placeholder="Logradouro" maxlength="100" required>
            <input type="text" name="numero" placeholder="Numero" maxlength="10" required>
            <input type="text" name="complemento" placeholder="Complemento" maxlength="50">
            <input type="text" name="bairro" placeholder="Bairro" maxlength="50" required>
            <input type="text" name="cidade" placeholder="Cidade" maxlength="50" required>
            <input type="text" name="pais" placeholder="Pais" maxlength="60" value="Brasil" required>

            <select name="estado" id="estado">
                <option value="">Selecione</option>
                <option>AC</option>
                <option>AL</option>
                <option>AP</option>
                <option>AM</option>
                <option>BA</option>
                <option>CE</option>
                <option>DF</option>
                <option>ES</option>
                <option>GO</option>
                <option>MA</option>
                <option>MT</option>
                <option>MS</option>
                <option>MG</option>
                <option>PA</option>
                <option>PB</option>
                <option>PR</option>
                <option>PE</option>
                <option>PI</option>
                <option>RJ</option>
                <option>RN</option>
                <option>RS</option>
                <option>RO</option>
                <option>RR</option>
                <option>SC</option>
                <option>SP</option>
                <option>SE</option>
                <option>TO</option>
            </select>

            <div class="address-purpose-selectors">
                <label class="checkout-checkbox">
                    <input type="checkbox" name="isEntrega" value="true" checked>
                    <span>Usar como endereco de entrega</span>
                </label>

                <label class="checkout-checkbox">
                    <input type="checkbox" name="isCobranca" value="true" checked>
                    <span>Usar como endereco de cobranca</span>
                </label>
            </div>

            <div class="modal-actions">
                <button type="button" id="closeModal" class="btn-secondary">Cancelar</button>
                <button type="submit" class="btn-primary">Salvar</button>
            </div>
        </form>
    </div>
</div>

<script src="~/assets/js/endereco.js"></script>
