@model List<Endereco>

<section class="address-page">

    <div class="address-container">

        <div class="breadcrumb">
            <a asp-controller="Cliente" asp-action="AreaCliente">
                Central Minha Conta
            </a>
            / <strong>Endereços</strong>
        </div>

        <div class="address-header">
            <h2>Endereços</h2>

            <button class="btn-primary" id="openModal">
                + Cadastrar Novo Endereço
            </button>
        </div>

        <div class="address-grid">

            @foreach (var e in Model) {
                <div class="address-card">

                    <div class="address-top">
                        <h4>@e.NomeEndereco</h4>
                    </div>

                    <p>@e.Logradouro, @e.Numero</p>
                    <p>@e.Bairro.Nome - @e.Cidade.Nome/@e.Cidade.Estado.Sigla</p>
                    <p>CEP: @e.CEP</p>

                    <div class="address-actions">
                        <form asp-action="ExcluirEndereco" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@e.Id" />
                            <button type="submit" class="btn-danger btn-sm"
                                    onclick="return confirm('Tem certeza que deseja excluir este endereço?');">
                                Excluir
                            </button>
                        </form>

                        <a asp-action="EditarEndereco" asp-route-id="@e.Id"
                           class="btn-outline btn-sm">
                            Editar
                        </a>

                        @if (e.IsPadrao) {
                            <span class="badge">Padrão</span>
                        }

                        @if (!e.IsPadrao) {
                            <a asp-action="TornarPadrao" asp-route-id="@e.Id" class="make-default">
                                Tornar padrão
                            </a>
                        }
                    </div>

                </div>
            }

        </div>
    </div>
</section>

<!-- 🔥 MODAL NOVO ENDEREÇO -->
<div class="modal-overlay" id="addressModal">
    <div class="modal">

        <h3>Novo Endereço</h3>

        <form asp-action="CadastrarEndereco" method="post">

            <input type="text"
                   name="nomeEndereco"
                   placeholder="Nome do endereço (Ex: Casa)"
                   maxlength="50"
                   required>

            <input type="text"
                   name="cep"
                   placeholder="CEP"
                   maxlength="9"
                   pattern="\d{5}-\d{3}"
                   required>

            <input type="text"
                   name="logradouro"
                   placeholder="Logradouro"
                   maxlength="100"
                   required>

            <input type="text"
                   name="numero"
                   placeholder="Número"
                   maxlength="10"
                   required>

            <input type="text"
                   name="complemento"
                   placeholder="Complemento"
                   maxlength="50">

            <input type="text"
                   name="bairro"
                   placeholder="Bairro"
                   maxlength="50"
                   required>

            <input type="text"
                   name="cidade"
                   placeholder="Cidade"
                   maxlength="50"
                   required>

            <select name="estado" id="estado">
                <option value="">Selecione</option>
                <option>AC</option>
                <option>AL</option>
                <option>AP</option>
                <option>AM</option>
                <option>BA</option>
                <option>CE</option>
                <option>DF</option>
                <option>ES</option>
                <option>GO</option>
                <option>MA</option>
                <option>MT</option>
                <option>MS</option>
                <option>MG</option>
                <option>PA</option>
                <option>PB</option>
                <option>PR</option>
                <option>PE</option>
                <option>PI</option>
                <option>RJ</option>
                <option>RN</option>
                <option>RS</option>
                <option>RO</option>
                <option>RR</option>
                <option>SC</option>
                <option>SP</option>
                <option>SE</option>
                <option>TO</option>
            </select>

            <div class="modal-actions">
                <button type="button" id="closeModal" class="btn-secondary">Cancelar</button>
                <button type="submit" class="btn-primary">Salvar</button>
            </div>

        </form>

    </div>
</div>

<script src="~/assets/js/endereco.js"></script>