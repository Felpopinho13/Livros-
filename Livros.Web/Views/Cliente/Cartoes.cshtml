@model List<Livros.Domain.Cartao>

<section class="wallet-page">
    <div class="wallet-container">

        <div class="wallet-header">
            <h2>Cartões</h2>

            <button class="btn-primary" id="openCardModal">
                + Adicionar Cartão de Crédito
            </button>
        </div>

        <div class="wallet-grid">

            @foreach (var c in Model) {
                <div class="wallet-card @(c.IsPadrao ? "primary" : "")">

                    <div class="wallet-card-top">
                        <strong>@c.NomeImpresso</strong>

                        @if (c.IsPadrao) {
                            <span class="badge">Padrão</span>
                        }
                    </div>

                    <p>**** **** **** @c.Numero.Substring(c.Numero.Length - 4)</p>
                    <p>Vence em @c.Validade</p>

                    <div class="wallet-actions">

                        <form asp-action="ExcluirCartao" method="post">
                            <input type="hidden" name="id" value="@c.Id" />

                            <button type="submit"
                                    onclick="return confirm('Tem certeza que deseja remover este cartão?');">
                                Remover
                            </button>
                        </form>

                        @if (!c.IsPadrao) {
                            <a asp-action="TornarCartaoPadrao" asp-route-id="@c.Id">
                                Tornar padrão
                            </a>
                        }

                    </div>
                </div>
            }

        </div>
    </div>
</section>

<div class="modal-overlay" id="cardModal">
    <div class="modal">

        <h3>Novo Cartão</h3>

        <form asp-action="CadastrarCartao" method="post">

            <input type="text" name="nome" placeholder="Nome impresso" required>
            <input type="text" name="numero" placeholder="Número do cartão" required>

            <div class="form-row">
                <input type="text" name="validade" placeholder="MM/AA" required>
                <input type="text" name="cvv" placeholder="CVV" required>
            </div>

            <div class="modal-actions">
                <button type="button" id="closeCardModal">Cancelar</button>
                <button type="submit">Salvar</button>
            </div>

        </form>
    </div>
</div>

<script>
    const modal = document.getElementById("cardModal");
    const openBtn = document.getElementById("openCardModal");
    const closeBtn = document.getElementById("closeCardModal");

    openBtn.onclick = () => modal.style.display = "flex";
    closeBtn.onclick = () => modal.style.display = "none";
</script>