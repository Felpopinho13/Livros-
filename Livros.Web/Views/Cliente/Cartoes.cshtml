@model Livros.Web.Models.ViewModels.CartoesViewModel

<section class="account-page">
    <div class="container account-layout">
        @await Html.PartialAsync("_AccountSidebar")

        <div class="account-content">
            <section class="wallet-page account-section-page">
                <div class="wallet-container">
                    <div class="breadcrumb">
                        <a asp-controller="Cliente" asp-action="AreaCliente">
                            Central Minha Conta
                        </a>
                        / <strong>Cartoes</strong>
                    </div>

                    @if (TempData["Sucesso"] != null) {
                        <div class="checkout-feedback success">@TempData["Sucesso"]</div>
                    }

                    @if (TempData["Erro"] != null) {
                        <div class="checkout-feedback error">@TempData["Erro"]</div>
                    }

                    <div class="wallet-header">
                        <h2>Cartoes</h2>

                        <button class="btn-primary" id="openCardModal" type="button">
                            + Adicionar cartao de credito
                        </button>
                    </div>

                    <div class="wallet-grid">
                        @if (!Model.Cartoes.Any()) {
                            <div class="wallet-card wallet-card-empty">
                                <strong>Nenhum cartao cadastrado</strong>
                                <p>Cadastre um cartao com bandeira valida para usar no checkout.</p>
                            </div>
                        }

                        @foreach (var c in Model.Cartoes) {
                            <div class="wallet-card @(c.IsPadrao ? "primary" : "")">
                                <div class="wallet-card-top">
                                    <div>
                                        <strong>@c.NomeImpresso</strong>
                                        <p class="wallet-brand">@c.BandeiraCartao?.Nome</p>
                                    </div>

                                    @if (c.IsPadrao) {
                                        <span class="badge">Padrao</span>
                                    }
                                </div>

                                <p>**** **** **** @c.Numero.Substring(Math.Max(c.Numero.Length - 4, 0))</p>
                                <p>Validade: @c.Validade</p>

                                <div class="wallet-actions">
                                    <form asp-action="ExcluirCartao" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />

                                        <button type="submit" class="btn-danger btn-sm"
                                                onclick="return confirm('Tem certeza que deseja remover este cartao?');">
                                            Remover
                                        </button>
                                    </form>

                                    @if (!c.IsPadrao) {
                                        <a asp-action="TornarCartaoPadrao" asp-route-id="@c.Id" class="make-default">
                                            Tornar padrao
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    </div>
</section>

<div class="modal-overlay" id="cardModal">
    <div class="modal">
        <h3>Novo cartao</h3>

        <form asp-action="CadastrarCartao" method="post">
            @Html.AntiForgeryToken()

            <select name="bandeiraCartaoId" required>
                <option value="">Selecione a bandeira</option>
                @foreach (var bandeira in Model.Bandeiras) {
                    <option value="@bandeira.Id">@bandeira.Nome</option>
                }
            </select>

            <input type="text" name="nome" placeholder="Nome impresso" maxlength="100" required>
            <input type="text" id="numeroCartao" name="numero" placeholder="Numero do cartao" maxlength="19" required>

            <div class="form-row">
                <input type="text" id="validadeCartao" name="validade" placeholder="MM/AA" maxlength="5" required>
                <input type="text" id="cvvCartao" name="cvv" placeholder="CVV" maxlength="3" required>
            </div>

            <div class="modal-actions">
                <button type="button" id="closeCardModal" class="btn-secondary">
                    Cancelar
                </button>

                <button type="submit" class="btn-primary">
                    Salvar
                </button>
            </div>
        </form>
    </div>
</div>

<script src="~/assets/js/cartoes.js"></script>
