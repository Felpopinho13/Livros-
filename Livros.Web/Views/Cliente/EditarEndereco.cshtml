@model Livros.Web.Models.ViewModels.EnderecoViewModel

@if (TempData["Sucesso"] != null) {
    <div class="alert-success">
        @TempData["Sucesso"]
    </div>
}

<section class="address-edit-page">

    <div class="address-edit-container">

        <div class="breadcrumb">
            <a asp-controller="Cliente" asp-action="AreaCliente">
                Central Minha Conta
            </a>
            / <a asp-controller="Cliente" asp-action="Enderecos">Meus Endereços</a>
            / <strong>Editar Endereço</strong>
        </div>

        <h2>Editar Endereço</h2>

        <form asp-action="EditarEndereco" method="post" class="address-form">

            <input type="hidden" asp-for="Id" />

            <div class="form-grid">

                <div class="form-group">
                    <label>Nome do endereço</label>
                    <input asp-for="NomeEndereco" />
                </div>

                <div class="form-group">
                    <label>CEP</label>
                    <input asp-for="CEP" />
                </div>

                <div class="form-group">
                    <label>Rua</label>
                    <input asp-for="Logradouro" />
                </div>

                <div class="form-group">
                    <label>Número</label>
                    <input asp-for="Numero" />
                </div>

                <div class="form-group">
                    <label>Complemento</label>
                    <input asp-for="Complemento" />
                </div>

                <div class="form-group">
                    <label>Bairro</label>
                    <input asp-for="Bairro" />
                </div>

                <div class="form-group">
                    <label>Cidade</label>
                    <input asp-for="Cidade" />
                </div>

                <div class="form-group">
                    <label>Estado</label>
                    <input asp-for="Estado" />
                </div>

            </div>

            <div class="form-actions">
                <a asp-action="Enderecos" class="btn-outline">
                    Cancelar
                </a>

                <button type="submit" class="btn-primary">
                    Salvar alterações
                </button>
            </div>

        </form>

    </div>
</section>

<script>
    setTimeout(() => {
        const alert = document.querySelector('.alert-success');
        if (alert) alert.style.display = 'none';
    }, 3000);
</script>