@model Livros.Web.Models.ViewModels.EnderecoViewModel

<section class="account-page">
    <div class="container account-layout">
        @await Html.PartialAsync("_AccountSidebar")

        <div class="account-content">
            @if (TempData["Sucesso"] != null) {
                <div class="alert-success">
                    @TempData["Sucesso"]
                </div>
            }

            <section class="address-edit-page account-section-page">
                <div class="address-edit-container">
                    <div class="breadcrumb">
                        <a asp-controller="Cliente" asp-action="AreaCliente">
                            Central Minha Conta
                        </a>
                        / <a asp-controller="Cliente" asp-action="Enderecos">Meus Endereços</a>
                        / <strong>Editar Endereço</strong>
                    </div>

                    <h2>Editar Endereço</h2>

                    <form asp-action="EditarEndereco" method="post" class="address-form">
                        <input type="hidden" asp-for="Id" />

                        <div class="form-grid">
                            <div class="form-group">
                                <label>Nome do endereço</label>
                                <input asp-for="NomeEndereco" />
                            </div>

                            <div class="form-group">
                                <label>CEP</label>
                                <input type="text" asp-for="CEP" maxlength="9" pattern="\d{5}-\d{3}">
                            </div>

                            <div class="form-group">
                                <label>Rua</label>
                                <input asp-for="Logradouro" />
                            </div>

                            <div class="form-group">
                                <label>Número</label>
                                <input asp-for="Numero" />
                            </div>

                            <div class="form-group">
                                <label>Complemento</label>
                                <input asp-for="Complemento" />
                            </div>

                            <div class="form-group">
                                <label>Bairro</label>
                                <input asp-for="Bairro" />
                            </div>

                            <div class="form-group">
                                <label>Cidade</label>
                                <input asp-for="Cidade" />
                            </div>

                            <div class="form-group">
                                <label>Estado</label>
                                <select asp-for="Estado" class="form-control">
                                    <option value="">Selecione</option>
                                    <option>AC</option>
                                    <option>AL</option>
                                    <option>AP</option>
                                    <option>AM</option>
                                    <option>BA</option>
                                    <option>CE</option>
                                    <option>DF</option>
                                    <option>ES</option>
                                    <option>GO</option>
                                    <option>MA</option>
                                    <option>MT</option>
                                    <option>MS</option>
                                    <option>MG</option>
                                    <option>PA</option>
                                    <option>PB</option>
                                    <option>PR</option>
                                    <option>PE</option>
                                    <option>PI</option>
                                    <option>RJ</option>
                                    <option>RN</option>
                                    <option>RS</option>
                                    <option>RO</option>
                                    <option>RR</option>
                                    <option>SC</option>
                                    <option>SP</option>
                                    <option>SE</option>
                                    <option>TO</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-actions">
                            <a asp-action="Enderecos" class="btn-outline">
                                Cancelar
                            </a>

                            <button type="submit" class="btn-primary">
                                Salvar alterações
                            </button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</section>

<script>
    setTimeout(() => {
        const alert = document.querySelector('.alert-success');
        if (alert) alert.style.display = 'none';
    }, 3000);
</script>
