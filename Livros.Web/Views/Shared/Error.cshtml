@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="container" style="padding: 48px 16px 64px;">
    <div style="max-width: 720px; margin: 0 auto; background: #fff; border-radius: 12px; padding: 32px; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);">
        <h1 style="margin: 0 0 12px; color: #0f172a;">Algo deu errado</h1>
        <p style="margin: 0 0 18px; color: #475569; line-height: 1.6;">
            O sistema encontrou um erro inesperado ao processar sua solicitacao.
            Nossa aplicacao registrou esse evento para facilitar a analise.
        </p>

        @if (!string.IsNullOrWhiteSpace(Model.Path)) {
            <p style="margin: 0 0 10px; color: #334155;">
                <strong>Rota:</strong> @Model.Path
            </p>
        }

        @if (Model.ShowRequestId) {
            <p style="margin: 0 0 24px; color: #334155;">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <a href="/" class="btn-primary" style="text-decoration: none;">Voltar para a loja</a>
            <a href="javascript:history.back()" class="btn-secondary" style="text-decoration: none;">Voltar para a pagina anterior</a>
        </div>
    </div>
</div>
