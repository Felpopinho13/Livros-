@{
    var usuario = Context.Session.GetString("Usuario");
    var isAdmin = Context.Session.GetString("IsAdmin");

}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>BookStore</title>

    <link rel="stylesheet" href="~/assets/css/main.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>

<body>

    <header class="header">
        <div class="container">
            <a asp-controller="Home" asp-action="Index" class="logo">
                BookStore
            </a>

            <form class="search-box">
                <input type="text" placeholder="Buscar livros..." class="input">
                <button type="submit">🔍</button>
            </form>

            <nav class="nav-icons">
                <a asp-controller="Home" asp-action="Index">🏠</a>
                <a href="#">🛒</a>
                <button>❤</button>

                <a asp-controller="Cliente" asp-action="AreaCliente">👤</a>

                @if (isAdmin == "True") {
                    <a asp-controller="Admin" asp-action="Dashboard">⚙</a>
                }

                @if (usuario != null) {
                    <a asp-controller="Auth" asp-action="Logout" class="btn-logout">Sair</a>
                }
                
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer class="footer">
        <div class="container">
            <p>© 2026 BookStore - Todos os direitos reservados</p>
        </div>
    </footer>

    <script src="~/assets/js/main.js"></script>
    <script src="~/assets/js/cart.js"></script>
    <script src="~/assets/js/wishlist.js"></script>

</body>
</html>