@inject Livros.Web.Services.UserSessionService UserSessionService
@inject Livros.Web.Services.CartSessionService CartSessionService
@{
    var usuario = UserSessionService.GetUserEmail(Context.Session);
    var isAdmin = UserSessionService.IsAdmin(Context.Session);
    var carrinhoCount = CartSessionService.LoadCart(Context.Session).Sum(item => item.Quantidade);
    var buscaAtual = Context.Request.Query["busca"].ToString();
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>BookStore</title>

    <link rel="stylesheet" href="~/assets/css/fonts.css">
    <link rel="stylesheet" href="~/assets/css/main.css">
    <link rel="stylesheet" href="~/assets/icons/boxicons/css/boxicons.min.css">
</head>

<body>
    <header class="header">
        <div class="container">
            <a asp-controller="Home" asp-action="Index" class="logo">
                BookStore
            </a>

            <form asp-controller="Home" asp-action="Index" method="get" class="search-box">
                <input type="text" name="busca" value="@buscaAtual" placeholder="Buscar livros..." class="input">
                <button type="submit"><i class="bx bx-search"></i></button>
            </form>

            <nav class="nav-icons">
                <a asp-controller="Home" asp-action="Index" aria-label="Home"><i class="bx bx-home"></i></a>
                <a asp-controller="Pedido" asp-action="Carrinho" aria-label="Carrinho"><i class="bx bx-cart"></i> <span id="cart-count">@carrinhoCount</span></a>
                <button type="button" class="wishlist-header" id="wishlistToggle" aria-label="Favoritos">
                    <i class="bx bx-heart"></i>
                    <span id="wishlistCount">0</span>
                </button>
                <a asp-controller="Cliente" asp-action="AreaCliente" aria-label="Area do cliente"><i class="bx bx-user"></i></a>

                @if (isAdmin) {
                    <a asp-controller="Admin" asp-action="Dashboard" aria-label="Admin"><i class="bx bx-cog"></i></a>
                }

                @if (usuario != null) {
                    <a asp-controller="Auth" asp-action="Logout" class="btn-logout">Sair</a>
                }
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer class="footer">
        <div class="container">
            <p>&copy; 2026 BookStore - Todos os direitos reservados</p>
        </div>
    </footer>

    <div
        id="wishlistRoot"
        data-list-url="@Url.Action("List", "Wishlist")"
        data-add-url="@Url.Action("Add", "Wishlist")"
        data-remove-url="@Url.Action("Remove", "Wishlist")"
        data-login-url="@Url.Action("Login", "Auth")"
        data-details-url-template="@Url.Action("Detalhes", "Home", new { id = "__ID__" })">
    </div>

    <div class="modal-overlay" id="wishlistModal">
        <div class="modal wishlist-modal">
            <div class="modal-header">
                <h3>Minha lista de desejos</h3>
                <button type="button" id="closeWishlist" aria-label="Fechar">&times;</button>
            </div>
            <div class="wishlist-content"></div>
        </div>
    </div>

    @if (!isAdmin) {
        <div class="chatbot-shell" data-chatbot-root data-endpoint="@Url.Action("Recommend", "Chatbot")">
            <div class="chatbot-panel" data-chatbot-panel aria-hidden="true">
                <div class="chatbot-header">
                    <strong>Assistente de recomendacao</strong>
                    <span>Eu sugiro livros do catalogo usando sua busca e, quando possivel, o historico de compras.</span>
                </div>

                <div class="chatbot-messages" data-chatbot-messages>
                    <div class="chatbot-message assistant">
                        <div class="chatbot-message-bubble">
                            Ola! Me diga o que voce quer aprender, qual genero voce procura ou que tipo de leitura esta buscando.
                        </div>
                    </div>
                </div>

                <form class="chatbot-form" data-chatbot-form>
                    <div class="chatbot-input-row">
                        <textarea
                            class="chatbot-input"
                            data-chatbot-input
                            placeholder="Ex.: Quero um livro para aprender Java"
                            rows="3"></textarea>
                        <button type="submit" class="chatbot-submit" data-chatbot-submit aria-label="Enviar">
                            <i class="bx bx-send"></i>
                        </button>
                    </div>
                    <div class="chatbot-helper">As sugestoes sempre partem do catalogo cadastrado no sistema.</div>
                </form>
            </div>

            <button type="button" class="chatbot-toggle" data-chatbot-toggle aria-label="Abrir assistente">
                <i class="bx bx-message-rounded-dots"></i>
            </button>
        </div>
    }

    <script src="~/assets/js/main.js"></script>
    <script src="~/assets/js/chatbot.js"></script>
    <script src="~/assets/js/cart.js"></script>
    <script src="~/assets/js/wishlist.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
