<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Admin</title>

    <link rel="stylesheet" href="~/assets/css/main.css">
    <link rel="stylesheet" href="~/assets/css/admin/admin-layout.css">
    @RenderSection("Styles", required: false)
</head>

<body class="admin-body">

    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-logo">
                <h2>Painel Admin</h2>
            </div>

            <nav class="admin-menu">
                <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                <a asp-controller="Admin" asp-action="Clientes">Clientes</a>
                <a asp-controller="Admin" asp-action="Livros">Livros</a>
                <a asp-controller="Admin" asp-action="Estoque">Estoque</a>
                <a asp-controller="Admin" asp-action="Pedidos">Pedidos</a>
                <a asp-controller="Admin" asp-action="Trocas">Trocas</a>
                <a asp-controller="Admin" asp-action="AnaliseVendas">Análise de Vendas</a>
            </nav>

            <div class="admin-back-store">
                <a asp-controller="Home" asp-action="Index">
                    <span class="admin-back-icon" aria-hidden="true">&larr;</span>
                    <span>Voltar para Loja</span>
                </a>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-header">
                <h1>@ViewData["Title"]</h1>
                <div class="admin-user">
                    <span>Administrador</span>
                </div>
            </header>

            <section class="admin-content">
                <div class="admin-container">
                    @RenderBody()
                </div>
            </section>
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>

